<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Kable.ConfigStudio</RootNamespace>
    <AssemblyName>Kable.ConfigStudio</AssemblyName>
    <ApplicationTitle>Kable Config Studio</ApplicationTitle>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kable.Core\Kable.Core.csproj" />
    <ProjectReference Include="..\..\src\Kable\Kable.csproj" />
    <ProjectReference Include="..\..\src\Kable.Modbus\Kable.Modbus.csproj" />
    <ProjectReference Include="..\..\src\Kable.Melsec\Kable.Melsec.csproj" />
    <ProjectReference Include="..\..\src\Kable.Mqtt\Kable.Mqtt.csproj" />
    <ProjectReference Include="..\..\src\Kable.OpcUa\Kable.OpcUa.csproj" />
    <ProjectReference Include="..\..\src\Kable.UI.Wpf\Kable.UI.Wpf.csproj" />
  </ItemGroup>

</Project>
