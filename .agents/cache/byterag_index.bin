44738,0.08945754,0.016515238,0.11712735,0.20501938,0.018923711,0.19572501,0.12594275,0.070877895,0.0,0.086429745,0.0821566,0.041288096,0.21090996,0.016515238,0.094199695,0.17971423,0.10005191,0.12235818,0.016515238,0.13244769,0.11011776,0.035634805,0.06731926,0.0216271,0.08292026,0.0,0.09988406,0.031960044,0.15383855,0.14205071,0.08852591,0.08119992,0.122143954,0.16261162,0.0,0.1352465,0.108989306,0.08825428,0.12841785,0.15674655,0.10074296,0.048158016,0.07467043,0.12360383,0.26679042,0.0560082,0.15489624,0.26415896,0.16170113,0.07180539,0.13611308,0.017138455,0.16910888,0.11384353]},{"chunk":{"file_path":"tests\\Kable.SharedMemory.Tests\\SharedMemoryTransportTests.cs","chunk_index":473,"start_line":91,"end_line":105,"content":"                    serverContext.Input.AdvanceTo(seqReader.Position);\n\n                    // Echo back with \\n\n                    var mem = serverContext.Output.GetMemory(lineBytes.Length + 1);\n                    lineBytes.CopyTo(mem.Span);\n                    mem.Span[lineBytes.Length] = (byte)'\\n';\n                    serverContext.Output.Advance(lineBytes.Length + 1);\n                    await serverContext.Output.FlushAsync(cts.Token);\n                    break;\n                }\n                else\n                {\n                    serverContext.Input.AdvanceTo(buffer.Start, buffer.End);\n                }\n            }","score":0.0},"vector":[0.02412061,0.0,0.047347866,0.19104218,0.0,0.25489765,0.042095512,0.051135696,0.0,0.0,0.0,0.2342797,0.028408721,0.30131033,0.0,0.089826435,0.039344463,0.038160965,0.090646386,0.0,0.0,0.04261308,0.112330824,0.0,0.0,0.0,0.08149507,0.043335337,0.0,0.10227139,0.062397726,0.1065327,0.06728381,0.0,0.0,0.0,0.23596002,0.0,0.3996351,0.0,0.17698912,0.0,0.0,0.0,0.0,0.03873916,0.05558228,0.12744883,0.38361806,0.3113199,0.0,0.022041246,0.09469573,0.109264314,0.25589275,0.21852863,0.14439353,0.044082493,0.0,0.0,0.022828434,0.021667669,0.04824122,0.0]},{"chunk":{"file_path":"tests\\Kable.Sh