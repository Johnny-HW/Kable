_PublishMetric_BrokerReceivesValidJson()\n    {\n        // 1. 임베디드 인메모리 MQTT 서버 기동 (동적 포트 할당)\n        int testPort;\n        using (var l = new System.Net.Sockets.TcpListener(System.Net.IPAddress.Loopback, 0))\n        {\n            l.Start();\n            testPort = ((System.Net.IPEndPoint)l.LocalEndpoint).Port;\n            l.Stop();\n        }\n        var mqttFactory = new MqttFactory();\n        var serverOptions = new MqttServerOptionsBuilder()\n            .WithDefaultEndpoint()\n            .WithDefaultEndpointPort(testPort)","score":0.0},"vector":[0.32303095,0.078584954,0.03811382,0.1171359,0.12636884,0.2545785,0.039718453,0.19893143,0.0,0.18959685,0.0,0.01909541,0.1361526,0.122333184,0.015390329,0.07785051,0.3074266,0.0,0.14424853,0.06763471,0.019829849,0.13808785,0.14713077,0.08129368,0.107733585,0.055523578,0.18335555,0.1965245,0.0,0.084318556,0.1169297,0.019829849,0.07520653,0.12581548,0.0464216,0.1288218,0.0559693,0.12841663,0.06874347,0.23128136,0.06654325,0.23676042,0.20674606,0.11504505,0.06718863,0.0,0.14150384,0.08479621,0.05787757,0.08769999,0.031027881,0.0,0.13588664,0.056869604,0.033271626,0.20803502,0.03555697,0.01909541,0.11458896,0.13649382,0.06274206,0.09820497,0.09101011,0.030552655]},{"chunk":{"file_path":"tests\\Kable.Mqtt.Tests\\MqttTelemetryTests.cs","chunk_index":882,"start_line":31,"end_line":45,"content":"            .Build();\n\n        using var mqttServer = mqttFactory.CreateMqttServer(serverOptions);\n        await mqttServer.StartAsync();\n\n        try\n        {\n            var receivedTcs = new TaskCompletionSource<string>();\n\n            // 2. 수신용 테스트 클라이언트 (Subscriber)\n            using var subscriberClient = mqttFactory.CreateMqttClient();\n            var subOptions = new MqttClientOptionsBuilder()\n                .WithTcpServer(\"127.0.0.1\", testPort)\n                .WithClientId(\"TestSubscriber\")\n                .Build();","score":0.0},"vector":[0.35277542,0.08732108,0.07805529,0.27009815,0.10165662,0.0,0