,"content":"\n    public bool IsException => (FunctionCode & 0x80) != 0;\n    public byte ExceptionCode => IsException && Payload.Length > 0 ? Payload.Span[0] : (byte)0;\n\n    public ModbusTcpMessage(ushort transactionId, byte unitId, byte functionCode, ReadOnlyMemory<byte> payload, ushort protocolId = 0)\n    {\n        TransactionId = transactionId;\n        UnitId = unitId;\n        FunctionCode = functionCode;\n        Payload = payload;\n        ProtocolId = protocolId;\n    }\n\n    /// <summary>\n    /// FC03 / FC04 Read Holding/Input Registers 요청 생성 헬퍼","score":0.0},"vector":[0.0,0.053022247,0.20677069,0.0083405785,0.41282293,0.0,0.0,0.0083405785,0.03545753,0.033483192,0.27711457,0.13142887,0.15486744,0.050768733,0.008223106,0.089413345,0.035928648,0.23610856,0.080472134,0.047384154,0.0,0.21037461,0.0,0.1514234,0.0,0.008461456,0.017428074,0.0,0.16158198,0.016681157,0.09401077,0.03538427,0.0,0.02591524,0.045409814,0.19178858,0.23977591,0.0,0.04604939,0.0,0.0,0.0,0.08554439,0.008223106,0.09186724,0.09647778,0.0,0.2740426,0.11019041,0.0,0.0,0.0,0.03385294,0.1637144,0.3667288,0.080311306,0.0,0.14593427,0.0,0.0,0.09730674,0.2680466,0.0,0.0]},{"chunk":{"file_path":"src\\Kable.Modbus\\Messages\\ModbusTcpMessage.cs","chunk_index":51,"start_line":31,"end_line":45,"content":"    /// </summary>\n    public static ModbusTcpMessage CreateReadRegisters(ushort transactionId, byte unitId, byte functionCode, ushort startAddress, ushort quantity)\n    {\n        byte[] payload = new byte[4];\n        BinaryPrimitives.WriteUInt16BigEndian(payload.AsSpan(0, 2), startAddress);\n        BinaryPrimitives.WriteUInt16BigEndian(payload.AsSpan(2, 2), quantity);\n        return new ModbusTcpMessage(transactionId, unitId, functionCode, payload);\n    }\n\n    /// <summary>\n    /// FC06 Write Single Register 요청 생성 헬퍼\n    /// </summary>\n    public static ModbusTcpMessage CreateWriteSingleRegister(ushort transactionId, byte unitId, ushort address, ushort value)\n    {\n        byte[] payload = new byte[4];","score":0.0},"vector":[0.0,0.1714363,0.30642286,0.008134993,0.3525019,0.050445613,0.0,0.039174963,0.050581787,0.06782739,0.21956646,0.30826655,0.19318923,0.0,0.025048003,0.10838672,0.062258918,0.10962479,0.099099,0.046246205,0.0,0.056664307,0.0,0.087359615,0.0,0.008258251,0.124517836,0.0,0.198788,0.016269986,0.0,0.0,0.04542038,0.11327367,0.048508663,0.15018895,0.22890523,0.0,0.04488602,0.0,0.0,0.0,0.21512468,0.042621363,0.035855446,0.07989875,0.07156146,0.21124849,0.13571258,0.098595455,0.029865455,0.0,0.016269986,0.06572448,0.40527448,0.078342445,0.08125291,0.15117079,0.0,0.0,0.0,0.13496342,0.0,0.052629158]},{"chunk":{"file_path":"src\\Kable.Modbus\\Messages\\ModbusTcpMessage.cs","chunk_index":52,"start_line":46,"end_line":60,"content":"        BinaryPrimitives.WriteUInt16BigEndian(payload.AsSpan(0, 2), address);\n        BinaryPrimitives.WriteUInt16BigEndian(payload.AsSpan(2, 2), value);\n        return new ModbusTcpMessage(transactionId, unitId, 0x06, payload);\n    }\n\n    /// <summary>\n    /// FC16 Write Multiple Registers 요청 생성 헬퍼\n    /// </summary>\n    public static ModbusTcpMessage CreateWriteMultipleRegisters(ushort transactionId, byte unitId, ushort startAddress, ReadOnlySpan<ushort> values)\n    {\n        int byteCount = values.Length * 2;\n        byte[] payload = new byte[5 + byteCount];\n\n        BinaryPrimitives.WriteUInt16BigEndian(payload.AsSpan(0, 2), startAddress);\n        BinaryPrimitives.WriteUInt16BigEndian(payload.AsSpan(2, 2), (ushort)values.Length);","score":0.0},"vector":[0.0,0.082926095,0.2716425,0.010151415,0.44823077,0.19398558,0.0,0.05421412,0.020744193,0.040826343,0.298753,0.12146927,0.08995228,0.0,0.05887495,0.063019626,0.040895704,0.0,0.07796225,0.058083743,0.0,0.029041871,0.0,0.04062405,0.0,0.010372097,0.08179141,0.0,0.3541773,0.02030283,0.0,0.0,0.0,0.009939927,0.09809053,0.31933814,0.10842467,0.0,0.05566359,0.0,0.0,0.013253235,0.3396851,0.08082932,0.08377463,0.051792245,0.064802624,0.13879809,0.1780022