r serverPipe = new NamedPipeServerStream(\n                pipeName,\n                PipeDirection.InOut,\n                1,\n                PipeTransmissionMode.Byte,\n                PipeOptions.Asynchronous);\n\n            await serverPipe.WaitForConnectionAsync(cts.Token);","score":0.0},"vector":[0.38806978,0.0,0.0,0.2876251,0.0,0.0,0.068091854,0.041899532,0.11280643,0.16459726,0.056403216,0.038591668,0.055516876,0.28935468,0.024040714,0.0,0.0730601,0.10862841,0.0,0.0,0.0,0.083799064,0.0,0.12893978,0.0,0.06665834,0.24854127,0.100762606,0.050568394,0.0,0.050568394,0.107640885,0.0,0.056403216,0.079186,0.15518981,0.048081428,0.055338997,0.0,0.03760214,0.10113679,0.3174567,0.0,0.178073,0.025727782,0.0,0.0,0.07332418,0.034916278,0.026663339,0.0,0.13326378,0.08147131,0.027157102,0.24525674,0.054314204,0.18506649,0.12175931,0.058659345,0.0,0.0,0.37622288,0.14190252,0.03332917]},{"chunk":{"file_path":"tests\\Kable.Tests\\Cases\\Transports\\NamedPipeTransportTests.cs","chunk_index":1006,"start_line":31,"end_line":45,"content":"\n            var buffer = new byte[128];\n            int read = await serverPipe.ReadAsync(buffer, 0, buffer.Length, cts.Token);\n            string received = Encoding.UTF8.GetString(buffer, 0, read);\n\n            byte[] responseBytes = Encoding.UTF8.GetBytes(\"PIPE_ACK:\" + received + \"\\n\");\n            await serverPipe.WriteAsync(responseBytes, 0, responseBytes.Length, cts.Token);\n            await serverPipe.FlushAsync(cts.Token);\n            await Task.Delay(Timeout.Infinite, cts.Token);\n        }, cts.Token);\n\n        try\n        {\n            await using var session = new KableClientBuilder<string>()\n                .UseNamedPipe(pipeName, timeoutMs: 3000)","score":0.0},"vector":[0.15643536,0.025673151,0.13359179,0.10675517,0.18219656,0.098584905,0.11062342,0.12963432,0.0,0.1331076,0.05029842,0.115634225,0.11128007,0.15482885,0.0,0.1323347,0.39185265,0.10610413,0.05858951,0.051346302,0.08498698,0.014329201,0.33664927,0.04