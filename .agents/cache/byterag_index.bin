,0.05774641,0.0,0.028534323,0.15420832,0.027125219,0.0,0.13251372,0.18930957,0.06269079,0.014845559,0.048825398,0.0,0.1891023,0.2532283,0.059146557]},{"chunk":{"file_path":"tests\\Kable.Tests\\Cases\\Engine\\SessionInterleavingAndResilienceTests.cs","chunk_index":851,"start_line":181,"end_line":195,"content":"        var res = await nextTask;\n        res.Should().Be(\"OK_NEXT\");\n    }\n\n    [Fact]\n    public async Task TC_SES_07_SendUrgentAsync_UnderFifoContention_BypassesWaitingQueueImmediately()\n    {\n        var factory = new TestMemoryConnectionFactory();\n        var codec = new AsciiLineCodec(delimiter: 0x0A);\n        await using var session = new KableSession<string>(factory, codec);\n        await session.StartAsync();\n\n        // Lock FIFO with slow request\n        var slowTask = session.RequestAsync<string>(\"SLOW_MEASUREMENT\", TimeSpan.FromSeconds(5));\n","score":0.0},"vector":[0.25113782,0.029888045,0.022022769,0.1835483,0.0,0.061234035,0.0,0.0,0.022416031,0.03803933,0.3571946,0.06730035,0.044832066,0.49852735,0.0,0.0,0.09476123,0.0,0.09298502,0.0,0.0,0.0,0.0,0.09753642,0.06202648,0.050211914,0.3258327,0.04049348,0.10915633,0.019925361,0.0,0.061999463,0.0,0.0,0.07336156,0.0,0.0,0.04255247,0.020578653,0.18889838,0.09880514,0.14273337,0.21371709,0.058196757,0.0,0.06276489,0.11529566,0.104779914,0.04649251,0.022823598,0.0,0.045647196,0.14907838,0.0,0.0,0.05977609,0.25452152,0.037471574,0.0,0.0,0.0,0.20318899,0.25940916,0.0]},{"chunk":{"file_path":"tests\\Kable.Tests\\Cases\\Engine\\SessionInterleavingAndResilienceTests.cs","chunk_index":852,"start_line":196,"end_line":210,"content":"        // Send urgent message while slowTask is waiting for response\n        await session.SendUrgentAsync(\"EMERGENCY_SHUTDOWN\");\n\n        // Remote reader should receive both commands without deadlock\n        var readResult = await factory.Context.RemoteRead.ReadAsync();\n        string received = Encoding.UTF8.GetString(System.Buffers.BuffersExtensions.ToArray(readResult.Buffer));\n        factory.Context.RemoteRead.AdvanceTo(readResult.Buffer.End);\n\n        received.Should().Contain(\"SLOW_MEASUREMENT\");\n        received.Should().Contain(\"EMERGENCY_SHUTDOWN\");\n\n        // Complete the slow request\n        await factory.Context.WriteAsciiLineAsync(\"SLOW_DONE\", 0x0A);\n        var slowRes = await slowTask;\n        slowRes.Should().Be(\"SLOW_DONE\");","score":0.0},"vector":[0.13708264,0.06298141,0.027679805,0.1091988,0.0,0.0,0.0,0.024546241,0.0,0.052038033,0.0,0.10743884,0.11695192,0.2335603,0.0,0.2217317,0.04275754,0.13781314,0.10567148,0.13250424,0.05535961,0.049092483,0.16533531,0.027103141,0.13480024,0.21342796,0.059426147,0.0,0.06504754,0.06504754,0.0,0.048183363,0.0,0.0,0.22931227,0.100073144,0.106523015,0.092925064,0.06915974,0.25558227,0.18792808,0.2678588,0.24853049,0.176304,0.0,0.052506845,0.0,0.07546345,0.023231264,0.25100023,0.0,0.035160832,0.16235317,0.14877872,0.0,0.13181596,0.086730056,0.024091681,0.13732146,0.2362116,0.034235545,0.11997006,0.25155115,0.13370883]},{"chunk":{"file_path":"tests\\Kable.Tests\\Cases\\Engine\\SessionInterleavingAndResilienceTests.cs","chunk_index":853,"start_line":211,"end_line":225,"content":"    }\n\n    [Fact]\n    public async Task TC_SES_05_StartAsync_MultipleCalls_IdempotentAndThreadSafe()\n    {\n        var factory = new TestMemoryConnectionFactory();\n        var codec = new AsciiLineCodec(delimiter: 0x0A);\n        await using var session = new KableSession<string>(factory, codec);\n\n        // Multiple concurrent starts\n        var t1 = session.StartAsync().AsTask();\n        var t2 = session.StartAsync().AsTask();\n        var t3 = session.StartAsync().AsTask();\n\n        await Task.WhenAll(t1, t2, t3);","score":0.0},"vector":[0.24604367,0.037855122,0.029251685,0.20536686,0.0,0.078004494,0.0,0.04022107,0.0,0.13863957,0.0,0.093230374,0.10813925,0.45670065,0.0,0.027979871,0.12218984,0.0,0.05362809,0.0,0.10725618,0.0,0.0,0.095745765,0.08014748,0.05595974