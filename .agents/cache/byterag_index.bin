752304,0.11993887,0.0]},{"chunk":{"file_path":"tests\\Kable.Tests\\Cases\\Engine\\WatchdogTimeoutAndDisconnectTests.cs","chunk_index":96,"start_line":16,"end_line":30,"content":"    [Theory]\n    [InlineData(100)]\n    [InlineData(200)]\n    public async Task RequestAsync_HardwareSilence_ThrowsDeviceTimeoutExceptionAndReleasesLock(int timeoutMs)\n    {\n        var factory = new TestMemoryConnectionFactory();\n        var codec = new AsciiLineCodec(delimiter: 0x0A);\n        await using var session = new KableSession<string>(factory, codec);\n        await session.StartAsync();\n\n        Func<Task> actTimeout = async () => await session.RequestAsync<string>(\"SILENT_CMD\", TimeSpan.FromMilliseconds(timeoutMs));\n\n        var ex = await actTimeout.Should().ThrowAsync<DeviceTimeoutException>();\n        ex.Which.Command.Should().Be(\"SILENT_CMD\");\n","score":0.0},"vector":[0.28594226,0.03014794,0.0382831,0.11995254,0.0,0.14500864,0.0,0.1596628,0.03445479,0.25861228,0.0,0.035317622,0.0,0.39324486,0.0,0.0,0.09593349,0.0,0.03396951,0.0,0.01914155,0.032592367,0.0,0.09818765,0.06280821,0.03355597,0.40032408,0.14631513,0.050246567,0.020439282,0.07086082,0.06265563,0.03543041,0.0,0.028712327,0.0,0.0,0.13173842,0.0,0.15434444,0.058108278,0.13399084,0.12561642,0.0,0.0,0.06346934,0.116216555,0.24181263,0.02275316,0.0,0.0,0.035020333,0.063366205,0.0,0.0,0.06029588,0.1436887,0.070040666,0.11772053,0.12637527,0.0,0.3896081,0.18537238,0.06029588]},{"chunk":{"file_path":"tests\\Kable.Tests\\Cases\\Engine\\WatchdogTimeoutAndDisconnectTests.cs","chunk_index":97,"start_line":31,"end_line":45,"content":"\n        var nextTask = session.RequestAsync<string>(\"NEXT_CMD\", TimeSpan.FromSeconds(2));\n        await factory.Context.WriteAsciiLineAsync(\"NEXT_ACK\", 0x0A);\n        var res = await nextTask;\n        res.Should().Be(\"NEXT_ACK\");\n    }\n\n    [Fact]\n    public async Task RequestAsync_HardwareDisconnectedDuringWait_ThrowsDeviceDisconnectedExceptionFailFast()\n    {\n        var factory = new TestMemoryConnectionFactory();\n        var codec = new AsciiLineCodec(delimiter: 0x0A);\n        await using var session = new KableSession<string>(factory, codec);\n        await session.StartAsync();\n","score":0.0},"vector":[0.21764307,0.059409417,0.0,0.17118768,0.0,0.045186598,0.0,0.0,0.0,0.09732499,0.22871779,0.07952163,0.029423831,0.428902,0.0,0.0,0.06914144,0.0,0.0,0.0,0.0,0.06846455,0.0,0.1126527,0.08746007,0.03163062,0.32113168,0.027504884,0.28288397,0.055009775,0.0,0.045597386,0.0,0.0,0.021444488,0.0,0.07907655,0.0,0.0,0.15973808,0.04304224,0.055009767,0.324141,0.0,0.0,0.07292785,0.18730247,0.19261402,0.0,0.040813707,0.0,0.1369291,0.03667318,0.0,0.0,0.118818834,0.2613025,0.093720354,0.0,0.0,0.0,0.22256683,0.23704374,0.08162741]},{"chunk":{"file_path":"tests\\Kable.Tests\\Cases\\Engine\\WatchdogTimeoutAndDisconnectTests.cs","chunk_index":98,"start_line":46,"end_line":59,"content":"        var pendingTask = session.RequestAsync<string>(\"WAITING_CMD\", TimeSpan.FromSeconds(5)).AsTask();\n        await Task.Delay(50);\n\n        factory.Context.Abort(\"Physical Cable Disconnected\");\n\n        Func<Task> act = async () => await pendingTask;\n        await act.Should().ThrowAsync<DeviceDisconnectedException>();\n\n        session.IsConnected.Should().BeFalse();\n\n        Func<Task> actNew = async () => await session.RequestAsync<string>(\"NEXT_NEW_CMD\", TimeSpan.FromSeconds(1));\n        await actNew.Should().ThrowAsync<DeviceDisconnectedException>();\n    }\n}","score":0.0},"vector":[0.2949455,0.0,0.0,0.064764634,0.0,0.0,0.13535742,0.0,0.18034235,0.29946214,0.0,0.070057906,0.0,0.19770256,0.0,0.0,0.035980355,0.0,0.058399726,0.0,0.0,0.0,0.07196071,0.14128761,0.03809684,0.070197105,0.3824707,0.13151428,0.0,0.098111585,0.0,0.0,0.0,0.07850259,0.0,0.0,0.10362342,0.0,0.0,0.20829558,0.11679945,0.33787322,0.07619368,0.12660755,0.0,0.0,0.18092978,0.19976802,0.055933096,0.037008367,0.0,0.0,0.0,0.019625649,0.0,0.039251298,0.2117261,0.13580278,0.04