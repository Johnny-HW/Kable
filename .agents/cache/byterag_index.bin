y.Tests\\KableMetricsCollectorTests.cs":1788511853,"src\\Kable\\Extensions\\KableServiceExtensions.cs":1788498412,"AGENTS.md":1788501397,"tests\\Kable.Tests\\Cases\\Transports\\TransportAndBuilderTests.cs":1789960340,"tests\\Kable.Tests\\Cases\\Codecs\\CodecBaseTemplatesFaultInjectionTests.cs":1789444745,"tests\\Kable.Transport.Ipc.Tests\\IpcTransportIntegrationTests.cs":1788510551,"src\\Kable.Core\\HeartbeatOptions.cs":1788511699,"tests\\Kable.Generators.Tests\\SourceGeneratorExecutionTests.cs":1788510756,"src\\Kable.ConfigStudio\\MainWindow.xaml":1789550391,"src\\Kable.Modbus\\ModbusServiceCollectionExtensions.cs":1789550266,"src\\Kable\\Engine\\Profiles\\KableProfileConfig.cs":1789952781,"src\\Kable.Core\\Observability\\DeviceTelemetryStream.cs":1788772037,"src\\Kable\\Engine\\Profiles\\WeakSubscription.cs":1789952895,"src\\Kable.Core\\IConnectionContext.cs":1788503901,"src\\Kable\\Engine\\Profiles\\KableProfileManager.cs":1789952791,"src\\Kable\\Channels\\KableModbusDeviceChannel.cs":1789540927,"src\\Kable.Core\\Localization\\KableLocalizer.cs":1789963074,"tests\\Kable.Tests\\Cases\\Codecs\\ByteFragmentationTests.cs":1788510620,"tests\\Kable.Melsec.Tests\\MelsecSlmpTests.cs":1789549514,"CONTRIBUTING.md":1788500669,"src\\Kable\\Observability\\CommObserver.cs":1788503930,"src\\Kable.Mqtt\\MqttOptions.cs":1789549183,"src\\Kable\\Engine\\Profiles\\IKableProfileClient.cs":1789952889,"src\\Kable.Core\\Alarms\\IAlarmManager.cs":1789963116,"src\\Kable.Modbus\\ModbusTcpMaster.cs":1789550259,"docs\\03_OBSERVABILITY_LOGGING.md":1789706788,"src\\Kable.Grpc\\GrpcClientFactory.cs":1789545713,"src\\Kable.Melsec\\MelsecOptions.cs":1789549138,"tests\\Kable.Tests\\Cases\\Observability\\TelemetryRingBufferTests.cs":1788510225,"src\\Kable\\Engine\\Profiles\\GenericKableProfileClientImpl.cs":1789952658,"src\\Kable.ConfigStudio\\Models\\KableProfileModel.cs":1789550345,"src\\Kable.OpcUa\\OpcUaServiceCollectionExtensions.cs":1789549234,"tests\\Kable.Tests\\Cases\\Checksums\\ChecksumsTests.cs":1788770832,"docs\\01_ARCHITECTURE_OVERVIEW.md":1789704885,"src\\Kable.Core\\Exceptions\\KableExceptions.cs":1789963084,"tests\\Kable.Host.Tests\\DaemonLifecycleTests.cs":1788511589,"tests\\Kable.Tests\\Cases\\Transports\\TcpListenerAndDiTests.cs":1789960997,"tests\\Kable.Tests\\Fixtures\\TestMemoryConnection.cs":1788500388,"docs\\README.md":1789704885,"docs\\CONVENTIONS.md":1789704885,"tests\\Kable.Tests\\Channels\\KableModbusDeviceChannelTests.cs":1789952268,"src\\Kable\\Engine\\Profiles\\StringKableProfileClientImpl.cs":1789952664,"src\\Kable\\Engine\\KableSession.cs":1789953535,"src\\Kable.Observability.OpenTelemetry\\KableMetricsCollector.cs":1788511891,"src\\Kable\\Codecs\\AsciiLineCodec.cs":1789440164}},"nodes":[{"chunk":{"file_path":"src\\README.md","chunk_index":0,"start_line":1,"end_line":15,"content":"# 01.Kable Source Modules (`src/`)\n\n`02.SoftwareLib/01.Kable/src`는 Microsoft의 `System.IO.Pipelines` 전송 계층과 RSocket 반응형 패턴을 결합하여 Zero-Allocation, 초저지연 하드웨어 I/O 통신을 제공하는 .NET 라이브러리 제품군입니다.\n\n---\n\n## 🏛️ 하위 서브 프로젝트 구성\n\n```mermaid\ngraph TD\n    Core[\"Kable.Core/<br/>(인터페이스, Checksum, ModbusRtuCodec)\"] --> Kable[\"Kable/<br/>(KableSession, TCP/Serial/Pipe Transports)\"]\n    Disruptor[\"Kable.Engine.Disruptor/<br/>(SpscRingBuffer, L1 Cache Padding)\"] --> Kable\n    Gen[\"Kable.Generators/<br/>(Roslyn Source Generator)\"] --> Kable\n    Kable --> OTel[\"Kable.Observability.OpenTelemetry/<br/>(메트릭스, RTT 측정)\"]\n    Kable --> IPC[\"Kable.Transport.Ipc/<br/>(NamedPipe IPC)\"]","score":0.0},"vector":[0.16228752,0.10727425,0.09593808,0.1061616,0.080676824,0.019834565,0.047496468,0.132484,0.071312785,0.13920693,0.07963805,0.1733035,0.14235277,0.044427168,0.0468567,0.27827775,0.081033036,0.08774179,0.030576993,0.29306915,0.08518194,0.12107623,0.07062544,0.088048674,0.069553316,0.11701339,0.13875563,0.18415701,0.071221285,0.11241705,0.115170255,0.044698443,0.15567762,0.019775117,0.08033868,0.057481814,0.035898555,0.40744796,0.03256907,0.09959548,0.11581929,0.1653699,0.18473642,0.06786904,0.049133316,0.10688302,0.14442609,0.0063471464,0.038549576,0.08733026,0.08699398,0.022342414,0.051843576,0.15203705,0.13845454,0.10152889,0.13884012,0.1718285,0.09590303,0.070461005,0.103332065,0.099902734,0.116009474,0.12410843]},{"chunk":{"file_path":"src\\README.md","chunk_index":1,"start_line":16,"end_line":30,"content":"    Kable --> Host[\"Kable.Host/<br/>(데몬 서비스)\"]\n```\n\n---\n\n## 📑 주요 서브 프로젝트별 역할\n\n| 서브 프로젝트 | 설명 및 핵심 컴포넌트 |\n| :--- | :--- |\n| **`Kable.Core/`** | • `IDeviceSession`, `IProtocolCodec`, `ICommObserver`<br/>• `IndustrialChecksums`: CRC-16 Modbus / CCITT 초고속 테이블 계산<br/>• `ModbusRtuCodec`: `ReadOnlySequence<byte>` 기반 제로 카피 프레이밍 코덱 |\n| **`Kable/`** | • `KableSession`: 하이브리드 트랜잭션 라우터 (비-Correlation FIFO 락 & 고속 파이프라이닝)<br/>• `Transports/`: `TcpConnection`, `SerialPortConnection`, `NamedPipeConnection`<br/>• `CommObserver`: 텔레메트리, 콘솔, 알람 분리 3채널 링버퍼 |\n| **`Kable.Engine.Disruptor/`** | • `SpscRingBuffer<T>`: 단일 생산자-단일 소비자(SPSC) 락프리 링버퍼<br/>• `PaddedSequence`: False Sharing(캐시 바운스)을 방지하기 위한 64바이트 L1 캐시라인 패딩 시퀀스 |\n| **`Kable.Generators/`** | • Roslyn C# 소스 생성기: `[DeviceCommand]` 특성을 분석하여 컴파일 타임에 패킷 인코딩/디코딩 보일러플레이트 코드 자동 생성 |\n| **`Kable.Observability.OpenTelemetry/`** | • `KableMetricsCollector`: I/O 대역폭, 패킷 처리 지연(Latency RTT), 패킷 에러율 메트릭 수집기 |\n| **`Kable.Transport.Ipc/`** | • `IpcNamedPipe`: 프로세스 간 초고속 IPC 통신 어댑터 |","score":0.0},"vector":[0.05586762,0.14050265,0.12661666,0.13221845,0.058427494,0.056991536,0.052713096,0.10933613,0.020305134,0.11985006,0.1057562,0.07340679,0.050379217,0.11552112,0.081417546,0.20706706,0.09142052,0.12595367,0.08495627,0.18420158,0.13576041,0.062864214,0.05570018,0.19073549,0.12684679,0.18265942,0.08575443,0.12726268,0.080100566,0.14307289,0.11070393,0.080299705,0.12999342,0.09227151,0.07010533,0.12270577,0.10605587,0.3418375,0.064596385,0.113282636,0.060425673,0.096965484,0.19429344,0.08248297,0.07489689,0.09222813,0.24202655,0.067119785,0.1074452,0.103533946,0.030359503,0.07723566,0.14848389,0.10916034,0.13970718,0.09906068,0.26011992,0.10559533,0.16074954,0.06595398,0.106515124,0.0643213,0.07215083,0.17953032]},{"chunk":{"file_path":"src\\README.md","chunk_index":2,"start_line":31,"end_line":31,"content":"| **`Kable.Host/`** | • `DaemonService`: 윈도우 서비스 또는 백그라운드 데몬으로 Kable 통신 호스팅 |","score":0.0},"vector":[0.0,0.0508971,0.11167037,0.026508905,0.021207126,0.12285506,0.12561142,0.18896718,0.04893952,0.043876808,0.13813995,0.11281781,0.05213123,0.22267482,0.17734547,0.10426246,0.022129174,0.0169657,0.06597772,0.23477387,0.15905343,0.07047291,0.071919814,0.0,0.04803323,0.12512945,0.045676887,0.2802966,0.14251187,0.17609946,0.0,0.037701555,0.02356347,0.0,0.026508905,0.1392387,0.12761158,0.43731013,0.0,0.122692555,0.044045568,0.0,0.04893952,0.0508971,0.02446976,0.06744028,0.272573,0.0,0.06059179,0.02544855,0.0,0.021938404,0.17637733,0.120536216,0.021207126,0.24973655,0.18498574,0.085559785,0.074224934,0.043876808,0.10552337,0.0715967,0.1751404,0.02544855]},{"chunk":{"file_path":"AGENTS.md","chunk_index":3,"start_line":1,"end_line":15,"content":"# 🧭 Kable - Antigravity Agent Rules\n\n> This file contains the top-level workspace rules automatically recognized and strictly adhered to by Antigravity AI during all `Kable` engineering tasks.\n\n---\n\n## 1. Single Source of Truth (SSOT) Enforcement\n- Before writing, designing, or modifying code, always strictly consult and adhere to the following baseline documents:\n  - `docs/PROJECT_SPEC.md`: Project mission, 3-tier architecture, and zero-allocation (0-GC) design principles.\n  - `docs/SYSTEM_DESIGN.md`: Core interfaces (`IConnectionContext`, `IProtocolCodec`, `IDeviceSession`), and pipeline interaction flows.\n  - `docs/CONVENTIONS.md`: Coding standards, modular file limits, prohibition of synchronous blocking, and TDD principles.\n\n## 2. Modular Isolation, File Size Control & Complexity-Driven Decomposition\n- A single file **MUST NOT exceed 300~500 lines**.\n- **Proactive Decomposition upon Rising Complexity**:","score":0.0},"vector":[0.07532041,0.035432685,0.10043131,0.018670024,0.07646553,0.14133051,0.049228936,0.15924816,0.17683691,0.099630386,0.39434975,0.07413604,0.013943437,0.040078044,0.14156766,0.16312207,0.03381074,0.09193369,0.026866619,0.21489464,0.037983842,0.24779436,0.026105626,0.057180494,0.107993275,0.0,0.108474076,0.04431448,0.07062279,0.20305662,0.046316307,0.13453512,0.073552094,0.12132021,0.018057892,0.20867734,0.04750194,0.2217886,0.0,0.060480915,0.116590664,0.14707471,0.019847414,0.009495961,0.07693985,0.07522873,0.12400544,0.20153429,0.03455641,0.0912112,0.046836667,0.1296185,0.0,0.25088575,0.04875602,0.08040315,0.07312801,0.23388979,0.1850854,0.13331653,0.10596192,0.095947884,0.028244395,0.08503886]},{"chunk":{"file_path":"AGENTS.md","chunk_index":4,"start_line":16,"end_line":30,"content":"  - Whenever a component's complexity grows (multiple distinct responsibilities, branching protocols, or growing test suites), **proactively split the file and organize into dedicated domain subdirectories** (e.g., `Cases/Transports/`, `Cases/Codecs/`, `Cases/Engine/`).\n  - Do not allow a single folder or file to become a catch-all flat dumping ground. Sibling projects in `src/` and `tests/` must maintain 1:1 structural symmetry.\n- Code omissions (`// ... existing code ...`, `// todo: rest of logic`, etc.) are strictly prohibited. Always produce complete and explicit code.\n- Strict 3-tier boundary isolation: Physical I/O (`Transports`) $\\rightarrow$ Framing & Serialization (`Codecs`) $\\rightarrow$ Reactive Interaction (`Engine`).\n\n## 3. Spec-Driven & Test-Driven Development (TDD)\n- When introducing new codecs, transport adapters, or session capabilities, always write unit and fault-injection tests in `tests/Kable.Tests/` or `tests/Kable.Generators.Tests/` first.\n- Implement only the minimal zero-allocation production code required to satisfy the tests.\n\n## 4. Phased Prompt Pipeline\n- Avoid monolithic, all-at-once modifications. Adhere strictly to the **Plan $\\rightarrow$ Review $\\rightarrow$ Execute** pipeline:\n  1. **Plan**: Present an implementation plan and the list of target files (under 300 lines each) without compromising existing architecture.\n  2. **Review**: Await user feedback and explicit approval.\n  3. **Execute**: Incrementally implement and verify only the approved scope.\n","score":0.0},"vector":[0.05158929,0.12939528,0.12890913,0.08786937,0.07422599,0.09218301,0.03967299,0.10940329,0.08782612,0.09466179,0.16452442,0.027211323,0.03826103,0.063597076,0.09719037,0.17199457,0.11016762,0.02253658,0.03476148,0.12757322,0.020867193,0.12876327,0.071863584,0.06592591,0.05179334,0.18926923,0.11523102,0.20389825,0.06445279,0.303318,0.16556178,0.059725445,0.047910646,0.19474486,0.03533927,0.0,0.13596456,0.18664747,0.011041883,0.28303307,0.048103187,0.07926414,0.049405664,0.11027804,0.17258056,0.11018451,0.009896258,0.18109809,0.13173813,0.11728078,0.09877041,0.063846394,0.090938896,0.07422902,0.15479256,0.1359187,0.20407519,0.24962999,0.079234205,0.18458125,0.09972532,0.11017447,0.14590506,0.025724147]},{"chunk":{"file_path":"AGENTS.md","chunk_index":5,"start_line":31,"end_line":33,"content":"## 5. Git Micro-Commits\n- Create micro-commits (`feat:`, `fix:`, `docs:`, `test:`, `refactor:`) for every verified atomic unit of work after passing builds and tests.\n- When an issue or context drift occurs, immediately reset (`git reset`) to the previous clean commit and restart the step cleanly instead of engaging in prolonged debugging dialogues.","score":0.0},"vector":[0.2515369,0.036793962,0.12576845,0.0,0.04393309,0.0,0.045992453,0.04825438,0.16530621,0.07746097,0.07583941,0.06541149,0.060733624,0.05887034,0.19363387,0.05957118,0.028858008,0.08345604,0.0,0.16021699,0.023361245,0.12499777,0.0,0.06207663,0.086574025,0.0,0.021966545,0.06727832,0.066898115,0.22293021,0.0,0.0,0.120595604,0.06262802,0.20080365,0.025375145,0.19570553,0.0,0.0,0.13935256,0.0,0.2532422,0.0,0.37060994,0.109019145,0.08005533,0.3571685,0.25322583,0.040882185,0.15075617,0.0,0.10150058,0.08952633,0.04459874,0.15221086,0.09596831,0.09811724,0.02412719,0.0,0.08750843,0.02264244,0.2542462,0.04528488,0.10337351]},{"chunk":{"file_path":"src\\Kable.SharedMemory\\Memory\\SharedMemoryRingBuffer.cs","chunk_index":6,"start_line":1,"end_line":15,"content":"namespace Kable.SharedMemory.Memory;\n\nusing System;\nusing System.IO.MemoryMappedFiles;\nusing System.Runtime.CompilerServices;\nusing System.Runtime.InteropServices;\nusing System.Threading;\n\n/// <summary>\n/// MMF 내부에 직접 배치되는 헤더 구조체 (64바이트 캐시라인 정렬).\n/// </summary>\n[StructLayout(LayoutKind.Explicit, Size = 256)]\npublic struct MmfRingBufferHeader\n{\n    public const uint ExpectedMagic = 0x4B41424C; // 'KABL'","score":0.0},"vector":[0.3972004,0.089966774,0.18975362,0.11642164,0.22061197,0.034032073,0.0215099,0.20797382,0.0,0.15072617,0.011087577,0.0,0.022175154,0.035329908,0.10810528,0.109066784,0.27187505,0.043426342,0.043563653,0.19528459,0.034109417,0.37582996,0.0460851,0.0,0.09979715,0.045863777,0.021270044,0.078801535,0.029529914,0.010856586,0.048790116,0.12389162,0.09760588,0.059659522,0.32632354,0.03158279,0.11975829,0.17354698,0.045508005,0.026172971,0.11061672,0.056336876,0.031905066,0.0,0.017949555,0.11421987,0.107401095,0.046983924,0.027141463,0.0,0.04400536,0.18851966,0.08514335,0.059390966,0.06935807,0.12112972,0.044238865,0.12860662,0.047787655,0.021270044,0.070699275,0.100261524,0.14609246,0.08734666]},{"chunk":{"file_path":"src\\Kable.SharedMemory\\Memory\\SharedMemoryRingBuffer.cs","chunk_index":7,"start_line":16,"end_line":30,"content":"    public const ushort CurrentVersion = 1;\n\n    [FieldOffset(0)]\n    public uint Magic;\n\n    [FieldOffset(4)]\n    public ushort Version;\n\n    [FieldOffset(8)]\n    public int Capacity;\n\n    [FieldOffset(12)]\n    public int Mask;\n\n    // Cache line 1: Producer Write Offset","score":0.0},"vector":[0.0,0.17318985,0.05734176,0.37840098,0.22117534,0.3370117,0.062120236,0.13354