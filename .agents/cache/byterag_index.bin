38867,0.0,0.0,0.066499144,0.13676816,0.078251205,0.13593704,0.019275112,0.025576593,0.07236671,0.102015726,0.14573729,0.086150184,0.0,0.0,0.0,0.11565068,0.0,0.12577614,0.6347059,0.12607385,0.0,0.03799951,0.019850489,0.08312392,0.03694397,0.0,0.0,0.16956772,0.092458695,0.09092616,0.0,0.21913697,0.11115008,0.04925862,0.1550461,0.0,0.09172294,0.21008545,0.07497452,0.04092255,0.043605994,0.0,0.030929832,0.07599902,0.3481701,0.06838477,0.0834499,0.09851724,0.025094014,0.0,0.07678769,0.0,0.15359996,0.0,0.020151256,0.023749692,0.119684994,0.09040206,0.0]},{"chunk":{"file_path":"src\\Kable\\Transports\\SerialPortConnection.cs","chunk_index":625,"start_line":46,"end_line":60,"content":"\n    public async ValueTask DisposeAsync()\n    {\n        if (Interlocked.Exchange(ref _isDisposed, 1) == 0)\n        {\n            _cts.Cancel();\n            try { await Input.CompleteAsync().ConfigureAwait(false); } catch (Exception) { /* Pipeline reader already completed */ }\n            try { await Output.CompleteAsync().ConfigureAwait(false); } catch (Exception) { /* Pipeline writer already completed */ }\n            _port.Dispose();\n            _cts.Dispose();\n        }\n    }\n}\n\npublic sealed class SerialPortConnectionFactory : IConnectionFactory","score":0.0},"vector":[0.29198456,0.06276835,0.19313122,0.0,0.12685813,0.0,0.02391175,0.13099481,0.0,0.0,0.10760288,0.0,0.10239629,0.10216089,0.06847455,0.317353,0.0,0.0,0.024297424,0.0,0.0,0.26873547,0.0,0.07322974,0.24536185,0.0,0.11477642,0.0,0.1369491,0.0,0.0,0.051080447,0.0,0.1351263,0.0,0.04635201,0.0478235,0.23238003,0.0,0.32286108,0.0,0.08694067,0.052857555,0.1255367,0.0,0.20303398,0.0,0.100017756,0.15124814,0.12960126,0.122680925,0.13632943,0.0,0.051946215,0.0,0.16183244,0.0,0.18404473,0.1303317,0.11693208,0.04707626,0.20003551,0.24826406,0.0]},{"chunk":{"file_path":"src\\Kable\\Transports\\SerialPortConnection.cs","chunk_index":626,"start_line":61,"end_line":75,"content":"{\n    private readonly string _portName;\n    priv