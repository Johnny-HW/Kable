n    /// </summary>\n    public static async ValueTask<IKableSimpleClient> OpenSerialAsync(","score":0.0},"vector":[0.2798627,0.04841705,0.10457195,0.07106078,0.111053884,0.07975336,0.043495703,0.113531634,0.103105724,0.11818269,0.050536025,0.14864723,0.08556153,0.26155192,0.06382126,0.07185774,0.05308015,0.05625249,0.060330816,0.17422447,0.112833105,0.12988725,0.15077515,0.07753329,0.09368608,0.02390768,0.14450708,0.260205,0.067676224,0.09603566,0.053308446,0.13906106,0.06507701,0.03552041,0.18903665,0.082058996,0.08549928,0.12731011,0.111857474,0.11285014,0.17091392,0.11417796,0.20860778,0.09787026,0.1506078,0.080716155,0.25949332,0.13779226,0.0653263,0.078754954,0.017513532,0.02831726,0.12924197,0.18095614,0.11852381,0.13350344,0.01085839,0.11440867,0.057772256,0.06632483,0.10750455,0.15341693,0.16468726,0.14057715]},{"chunk":{"file_path":"src\\Kable\\Simple\\KableSimple.cs","chunk_index":154,"start_line":31,"end_line":45,"content":"        string portName,\n        int baudRate = 9600,\n        Parity parity = Parity.None,\n        int dataBits = 8,\n        StopBits stopBits = StopBits.One,\n        byte delimiter = 0x0A,\n        Encoding? encoding = null,\n        ICommObserver? observer = null,\n        CancellationToken ct = default)\n    {\n        var codec = new AsciiLineCodec(delimiter, encoding);\n        var builder = new KableClientBuilder<string>()\n            .UseSerialPort(portName, baudRate, parity, dataBits, stopBits)\n            .UseCodec(codec);\n","score":0.0},"vector":[0.07784293,0.035848714,0.0,0.053607106,0.12773831,0.34381884,0.023089005,0.10889469,0.0,0.1893773,0.0,0.02898407,0.037840314,0.17208333,0.0,0.041915424,0.051570937,0.07741244,0.0,0.032434557,0.1751466,0.0,0.06336052,0.27090952,0.0,0.0,0.14708546,0.05922831,0.0,0.0,0.0,0.08972555,0.0,0.020957712,0.0,0.13742007,0.29040417,0.0,0.06703141,0.0,0.08012147,0.44014844,0.28096616,0.04953641,0.13653901,0.053421613,0.13580391,0.0,0.0,0.05796814,0.0,0.0,0.13406283,0.0,0.07568063,0.23057