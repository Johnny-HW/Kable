  _currentFifoTcs?.TrySetException(ex);\n            foreach (var kvp in _pendingRequests)\n            {\n                kvp.Value.TrySetException(ex);\n            }\n            _pendingRequests.Clear();\n            _incomingStream.Writer.TryComplete(ex);\n            _outboundNormalQueue.Writer.TryComplete(ex);\n            _outboundUrgentQueue.Writer.TryComplete(ex);\n        }","score":0.0},"vector":[0.0,0.061035093,0.27214816,0.09772535,0.10027193,0.0,0.056041308,0.09284439,0.031904705,0.16026549,0.0,0.0,0.08956521,0.15088539,0.13369592,0.0,0.14510506,0.0,0.0,0.055051252,0.0,0.0,0.0,0.098088145,0.18383189,0.054563064,0.17281714,0.0,0.1471778,0.020952344,0.0,0.0,0.0,0.10798516,0.20208229,0.06569803,0.0,0.10361434,0.17823866,0.11928593,0.0,0.1304434,0.0,0.29500574,0.16279444,0.0,0.0,0.0,0.0,0.092972435,0.15827236,0.16418657,0.103985704,0.14798667,0.0,0.29334727,0.06543491,0.44067767,0.13866875,0.13195099,0.18548417,0.0,0.0,0.0]},{"chunk":{"file_path":"src\\Kable\\Engine\\KableSession.cs","chunk_index":500,"start_line":271,"end_line":285,"content":"    }\n\n    private void EnsureConnected()\n    {\n        if (Volatile.Read(ref _isConnected) == 0 || _context == null)\n        {\n            throw new DeviceDisconnectedException(\"Connection is not open. Call StartAsync() first.\");\n        }\n    }\n\n    public async ValueTask StopAsync()\n    {\n        _sessionCts.Cancel();\n        OnConnectionClosed();\n","score":0.0},"vector":[0.3501975,0.07616116,0.23936343,0.0,0.1251219,0.07785363,0.04734342,0.07962303,0.07962303,0.07454071,0.0,0.0,0.0,0.0,0.20756659,0.0,0.19487736,0.0,0.0,0.08758534,0.0,0.0,0.0,0.0,0.08341461,0.0,0.30226856,0.0,0.08147473,0.0,0.07006827,0.0,0.0,0.29399273,0.0,0.0,0.04379267,0.08758534,0.05650667,0.067373335,0.0,0.0,0.09614631,0.18959267,0.10304157,0.0,0.0,0.04272455,0.0,0.0,0.20038463,0.0,0.43269804,0.0,0.0,0.2335609,0.0,0.11678045,0.0,0.0,0.27804452,0.18276615,0.07616115,0.0]},{"chunk":{"file_path":"src\\Kable\\Engine\\KableSession