123818,0.12603165,0.12844963,0.041114405,0.0,0.0,0.0,0.02521252,0.048193406,0.08807728,0.037283782,0.02779842,0.21129222,0.0,0.03603867,0.0,0.3192184,0.04220191,0.12415135,0.03285268,0.055483382,0.08775897,0.2781641]},{"chunk":{"file_path":"docs\\05_INDUSTRIAL_CHECKSUMS.md","chunk_index":401,"start_line":106,"end_line":120,"content":"<div style=\"background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: 16px; overflow: hidden;\">\n<div style=\"background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 10px 16px; display: flex; justify-content: space-between; align-items: center;\">\n<span style=\"font-weight: 700; font-size: 13.5px; color: #0369a1;\">① Modbus CRC-16 Calculation & In-Place Framing</span>\n<span style=\"background: #e0f2fe; color: #0369a1; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 6px;\">C# 13 / .NET 10</span>\n</div>\n<div style=\"padding: 14px 16px;\">\n\n```csharp\nusing Kable.Core.Checksums;\n\n// 1. Pure CRC-16 computation (0-GC stack allocation)\nReadOnlySpan<byte> payload = stackalloc byte[] { 0x01, 0x03, 0x00, 0x00, 0x00, 0x0A };\nushort crc = Crc16Modbus.Compute(payload); // 0xC5CD (Low: 0xC5, High: 0xCD)\n\n// 2. Validate incoming packet integrity","score":0.0},"vector":[0.1978767,0.0154061625,0.052718204,0.069642946,0.26767385,0.0075581754,0.017183546,0.2182192,0.010694015,0.2460248,0.107398055,0.04725943,0.13383481,0.037119042,0.15699147,0.018966742,0.066033915,0.33645552,0.028997233,0.16936116,0.09071774,0.14662313,0.02138803,0.120035976,0.027262535,0.038441338,0.05786425,0.032310065,0.044721358,0.055931654,0.0776327,0.010581447,0.1178778,0.007391451,0.28483394,0.06216455,0.11996931,0.12754056,0.08191414,0.12835531,0.18380076,0.18515182,0.16288607,0.12308971,0.0,0.0,0.058548186,0.0,0.11329895,0.020515049,0.2538654,0.21106358,0.08342266,0.08683893,0.07457626,0.060746152,0.015456116,0.12896696,0.03621811,0.054911457,0.04914892,0.02792326,0.009138522,0.26199913]},{"chunk":{"file_path":"docs\\05_INDUSTRIAL_CHECKSUMS.md","chunk_index":402,"start_line":121,"end_line":135,"content":"bool isValid = Crc16Modbus.Validate(receivedFrame);\nif (!isValid)\n{\n    throw new ProtocolViolationException(\"Modbus CRC-16 mismatch: frame corrupted.\");\n}\n\n// 3. In-place frame assembly with 0 heap allocation\nSpan<byte> txBuffer = stackalloc byte[payload.Length + 2];\npayload.CopyTo(txBuffer);\nCrc16Modbus.Append(payload, txBuffer); // Appends CRC atomically at the trailing 2 bytes\n```\n\n</div>\n</div>\n","score":0.0},"vector":[0.079551,0.055685695,0.067100935,0.022097496,0.066292495,0.08813887,0.23967285,0.0,0.0,0.10220092,0.21950346,0.0,0.13916172,0.06718299,0.12761305,0.08357844,0.04971937,0.040648654,0.027296906,0.07525093,0.096009806,0.0,0.07378531,0.029002964,0.06960712,0.19678707,0.48448625,0.0,0.17238191,0.07734124,0.030936496,0.0,0.051560827,0.0,0.0,0.17627774,0.20108722,0.0,0.051560827,0.0,0.04283515,0.0967147,0.30079684,0.11137139,0.032375403,0.021752223,0.0397755,0.043504447,0.13896607,0.0,0.024423549,0.11021127,0.36557025,0.0,0.175356,0.14991195,0.06052793,0.0,0.0,0.0,0.18756627,0.0,0.021417575,0.12285379]},{"chunk":{"file_path":"docs\\05_INDUSTRIAL_CHECKSUMS.md","chunk_index":403,"start_line":136,"end_line":150,"content":"<!-- Code Block 2 -->\n<div style=\"background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: 16px; overflow: hidden;\">\n<div style=\"background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 10px 16px; display: flex; justify-content: space-between; align-items: center;\">\n<span style=\"font-weight: 700; font-size: 13.5px; color: #059669;\">② Modbus ASCII LRC</span>\n<span style=\"background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 6px;\">2's Complement</span>\n</div>\n<div style=\"padding: 14px 16px;\">\n\n```csharp\nusing Kable.Core.Checksums;\n\nReadOnlySpan<byte> asciiData = stackalloc byte[] { 0x01, 0x03, 0x04, 0x02, 0x55 };\nbyte lrc = I