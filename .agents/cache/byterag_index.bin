isting(mmfName, MemoryMappedFileRights.ReadWrite);\n        var accessor = mmf.CreateViewAccessor(0, 0, MemoryMappedFileAccess.ReadWrite);\n\n        byte* ptr = null;\n        accessor.SafeMemoryMappedViewHandle.AcquirePointer(ref ptr);\n\n        var dataEvt = EventWaitHandle.OpenExisting(dataEvtName);\n        var spaceEvt = EventWaitHandle.OpenExisting(spaceEvtName);\n\n        return new SharedMemoryRingBuffer(mmf, accessor, ptr, dataEvt, spaceEvt, isCreator: false, 0);\n    }\n\n    [MethodImpl(MethodImplOptions.AggressiveInlining)]\n    private static (string MmfName, string DataEvtName, string SpaceEvtName) GetKernelObjectNames(string bufferName)","score":0.0},"vector":[0.0,0.21768397,0.13959561,0.16825224,0.22315426,0.0,0.17663261,0.0,0.042771075,0.0,0.09024393,0.0509101,0.036660925,0.40412533,0.19335906,0.04139136,0.1704022,0.1018202,0.08554215,0.17634274,0.077765584,0.0,0.14929551,0.17997085,0.0,0.10265058,0.047523417,0.0,0.032900825,0.019740498,0.034216862,0.14358862,0.017108431,0.06259181,0.08730288,0.0,0.40149114,0.019151228,0.0,0.16653761,0.023329679,0.054176696,0.0,0.20420776,0.0,0.02069568,0.0,0.0,0.06933201,0.0,0.11664838,0.039480995,0.0,0.10512241,0.07332185,0.10506,0.0,0.22060554,0.0,0.0,0.0,0.24436165,0.0,0.17418084]},{"chunk":{"file_path":"src\\Kable.SharedMemory\\Memory\\SharedMemoryRingBuffer.cs","chunk_index":16,"start_line":151,"end_line":165,"content":"        => ($\"{bufferName}_mmf\", $\"{bufferName}_data_evt\", $\"{bufferName}_space_evt\");\n\n    /// <summary>\n    /// 버퍼에 바이트 데이터를 기록(Produce)합니다.\n    /// </summary>\n    [MethodImpl(MethodImplOptions.AggressiveInlining)]\n    public int Write(ReadOnlySpan<byte> source)\n    {\n        if (source.IsEmpty || IsClosed) return 0;\n\n        long head = Volatile.Read(ref _header->Head);\n        long tail = Volatile.Read(ref _header->Tail);\n\n        long availableSpace = Capacity - (head - tail);\n        if (availableSpace <= 0) return 0;","score":0.0},"vector":[0.10777275,0.1138946,0.2