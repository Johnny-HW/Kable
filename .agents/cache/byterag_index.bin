ionCanceledException>();\n\n        var followUpTask = session.RequestAsync<string>(\"FOLLOW_UP\", TimeSpan.FromSeconds(2));\n        await factory.Context.WriteAsciiLineAsync(\"FOLLOW_UP_ACK\", 0x0A);\n        var res = await followUpTask;\n        res.Should().Be(\"FOLLOW_UP_ACK\");\n    }\n\n    [Fact]","score":0.0},"vector":[0.3380191,0.019019803,0.0,0.09310364,0.0,0.0,0.0,0.0,0.050989263,0.36571938,0.07211174,0.06962844,0.016642328,0.22044292,0.0,0.0,0.04608645,0.0,0.06407297,0.0,0.0,0.08802915,0.0,0.13090588,0.020309282,0.043414768,0.39726594,0.080502406,0.050247442,0.056327887,0.0,0.036203306,0.0,0.0,0.052097727,0.0,0.039286807,0.0,0.0,0.138183,0.12814593,0.24976388,0.17439811,0.11925419,0.0,0.0,0.0,0.15703532,0.03994159,0.0923774,0.0,0.0777932,0.1089316,0.0,0.0,0.038039606,0.26563612,0.15843938,0.025494631,0.0,0.041318882,0.109987035,0.4050429,0.03994159]},{"chunk":{"file_path":"tests\\Kable.Tests\\Cases\\Engine\\CancellationEdgeTests.cs","chunk_index":583,"start_line":61,"end_line":75,"content":"    public async Task TC_SES_110_RequestAsync_InvalidCastException_ReleasesFifoLockSafely()\n    {\n        var factory = new TestMemoryConnectionFactory();\n        var codec = new AsciiLineCodec(delimiter: 0x0A);\n        await using var session = new KableSession<string>(factory, codec);\n        await session.StartAsync();\n\n        // Request expecting an incompatible type (e.g. int when response is string)\n        var castFailTask = session.RequestAsync<int>(\"CMD_CAST_FAIL\", TimeSpan.FromSeconds(3)).AsTask();\n        await factory.Context.WriteAsciiLineAsync(\"TEXT_RESPONSE\", 0x0A);\n\n        Func<Task> actCast = async () => await castFailTask;\n        await actCast.Should().ThrowAsync<InvalidCastException>();\n\n        // Next request must acquire the lock immediately and succeed","score":0.0},"vector":[0.31681362,0.14243013,0.0,0.14306651,0.0,0.15486456,0.0,0.054820746,0.028164888,0.071417175,0.05081926,0.066964954,0.0,0.3294235,0.013282306,0.030414