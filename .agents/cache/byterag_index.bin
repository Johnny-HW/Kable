cs","chunk_index":1030,"start_line":16,"end_line":30,"content":"        if (deadbandDelta < 0) throw new ArgumentOutOfRangeException(nameof(deadbandDelta), \"Deadband must be non-negative.\");\n        _deadbandDelta = deadbandDelta;\n    }\n\n    /// <summary>\n    /// 새로운 값이 들어왔을 때, 데드밴드 임계치를 초과하여 상위에 보고할 가치가 있는지 판별합니다.\n    /// </summary>\n    /// <param name=\"currentValue\">현재 측정값</param>\n    /// <param name=\"shouldReport\">변화량이 임계치를 초과하면 true</param>\n    /// <returns>임계치 초과 시 true, 억제 시 false</returns>\n    public bool Evaluate(T currentValue, out double valAsDouble)\n    {\n        valAsDouble = Convert.ToDouble(currentValue);\n\n        lock (_lock)","score":0.0},"vector":[0.080972105,0.19193758,0.19017185,0.063525885,0.23430373,0.08738369,0.12072553,0.09319593,0.051561773,0.10422383,0.12561706,0.1737924,0.07628995,0.10708141,0.07495781,0.13862503,0.10544616,0.047399525,0.10657484,0.158172,0.0655282,0.10594812,0.043840583,0.22722934,0.09629946,0.1575578,0.14413358,0.10173212,0.08653426,0.27771947,0.054598544,0.10496774,0.121978775,0.006815412,0.07959051,0.11521718,0.067291364,0.08996014,0.15310118,0.075651795,0.07267396,0.11709743,0.18760633,0.10464966,0.04354508,0.047020875,0.11161575,0.066602185,0.12847903,0.101833895,0.08371066,0.099503346,0.15010414,0.12055846,0.17781097,0.1463592,0.19206326,0.0,0.01849254,0.11050583,0.1304518,0.23630612,0.14902362,0.07395849]},{"chunk":{"file_path":"src\\Kable\\Engine\\Profiles\\DeadbandFilter.cs","chunk_index":1031,"start_line":31,"end_line":45,"content":"        {\n            if (!_lastReportedValue.HasValue)\n            {\n                _lastReportedValue = valAsDouble;\n                return true;\n            }\n\n            double delta = Math.Abs(valAsDouble - _lastReportedValue.Value);\n            if (delta >= _deadbandDelta)\n            {\n                _lastReportedValue = valAsDouble;\n                return true;\n            }\n\n            return false;","score":0.0},"vector":[0.10823822,0.13