miter: 0x0A);\n\n        int pingCount = 0;\n        var options = new HeartbeatOptions<string>(\n            interval: TimeSpan.FromMilliseconds(40),\n            timeout: TimeSpan.FromSeconds(2),\n            pingFactory: () =>\n            {\n                Interlocked.Increment(ref pingCount);\n                return \"PING\";\n            },","score":0.0},"vector":[0.2730135,0.046084117,0.19233759,0.15793723,0.08469514,0.18449607,0.0,0.044767432,0.040175896,0.13650675,0.07643219,0.2122779,0.078343004,0.3718337,0.0,0.0,0.14774723,0.03333745,0.0,0.036438607,0.08979666,0.0,0.0,0.037306197,0.18865205,0.0,0.36671537,0.068124354,0.0313372,0.0,0.092774615,0.09644498,0.030722745,0.117158644,0.055959284,0.0,0.0,0.0,0.0,0.17291126,0.05222867,0.13624871,0.33988816,0.0,0.0,0.17080596,0.10445734,0.074612394,0.027979642,0.0,0.12563959,0.0,0.038216095,0.0,0.0,0.18840654,0.0,0.063953474,0.0,0.0,0.0,0.29584944,0.0,0.0]},{"chunk":{"file_path":"tests\\Kable.Tests\\Cases\\Engine\\HeartbeatWatchdogTests.cs","chunk_index":788,"start_line":31,"end_line":45,"content":"            isPongResponse: s => s == \"PONG\");\n\n        await using var session = new KableSession<string>(factory, codec, heartbeatOptions: options);\n        await session.StartAsync();\n\n        // Server responds to pings\n        var echoTask = Task.Run(async () =>\n        {\n            var reader = factory.Context.RemoteRead;\n            for (int i = 0; i < 3; i++)\n            {\n                var res = await reader.ReadAsync();\n                reader.AdvanceTo(res.Buffer.End);\n                await factory.Context.WriteAsciiLineAsync(\"PONG\", 0x0A);\n            }","score":0.0},"vector":[0.29872736,0.05297403,0.123530686,0.15322265,0.048364606,0.115069024,0.0,0.025094839,0.039118428,0.0,0.16524573,0.040923897,0.0,0.26732686,0.030930849,0.28974834,0.067352094,0.039118428,0.0,0.05115487,0.11826985,0.06650133,0.039702285,0.13606018,0.089047864,0.19211495,0.2645402,0.030227875,0.0,0.3655604,0.22030006,0