 of 10,000)\n        const int totalCount = 10200;\n        var writeTask = Task.Run(async () =>\n        {\n            for (int i = 0; i < totalCount; i++)\n            {","score":0.0},"vector":[0.33619934,0.0639385,0.018020056,0.14839005,0.0802999,0.15630828,0.0,0.039929785,0.0,0.0,0.02335933,0.0,0.06307019,0.34183025,0.0,0.15113276,0.1197528,0.0,0.0,0.03765385,0.0,0.0,0.0,0.22188775,0.12801579,0.03881243,0.44464675,0.07455309,0.025742937,0.09468448,0.0,0.07764323,0.0,0.0,0.08403018,0.0,0.0,0.09760863,0.0,0.12864318,0.07138178,0.14910617,0.28323832,0.05367676,0.05045616,0.17767188,0.14276356,0.060066856,0.020022282,0.0,0.047357973,0.0,0.05484364,0.0,0.0,0.07420023,0.16917074,0.052558497,0.051485874,0.0,0.0,0.325497,0.12941676,0.11170721]},{"chunk":{"file_path":"tests\\Kable.Tests\\Cases\\Engine\\ThreadingPipelineAndLifecycleTests.cs","chunk_index":719,"start_line":91,"end_line":105,"content":"                await factory.Context.WriteAsciiLineAsync($\"$DATA_{i:D5}\", 0x0A);\n            }\n        });\n\n        // Drain messages asynchronously to allow backpressure to relieve smoothly\n        int receivedCount = 0;\n        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(10));\n        await foreach (var item in session.GetStreamAsync(cts.Token))\n        {\n            receivedCount++;\n            if (receivedCount == totalCount) break;\n        }\n\n        await writeTask;\n        receivedCount.Should().Be(totalCount);","score":0.0},"vector":[0.21617235,0.085669465,0.040470097,0.07006263,0.080940194,0.11626306,0.066276364,0.16406798,0.0,0.07014818,0.0,0.10831117,0.0,0.18795356,0.0,0.12626672,0.15910684,0.0,0.0,0.06070515,0.0,0.2472823,0.35401428,0.035871223,0.18400937,0.02428206,0.2219198,0.051748652,0.0,0.06313336,0.07432366,0.0,0.0,0.21921304,0.09388365,0.0,0.2578845,0.06716315,0.0,0.17658113,0.0,0.16280018,0.15031752,0.15964757,0.114825875,0.09972558,0.0,0.0,0.025052918,0.071742445,0.11225009,0.09007997,0.095656596,0.0,0.0,0.11691362,0