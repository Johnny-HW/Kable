","chunk_index":358,"start_line":106,"end_line":120,"content":"using System.Threading;\nusing System.Threading.Tasks;\n\npublic interface IDeviceSession<TMessage> : IAsyncDisposable, IDisposable\n{\n    bool IsConnected { get; }\n    \n    // 1. Real-time telemetry streaming channel\n    IAsyncEnumerable<TMessage> Stream { get; }\n    \n    // 2. Fire-and-forget notification\n    ValueTask SendAsync(TMessage message, CancellationToken ct = default);\n    \n    // 3. Request-Response RPC with Watchdog isolation\n    ValueTask<TResponse> RequestAsync<TResponse>(TMessage request, TimeSpan timeout, CancellationToken ct = default);","score":0.0},"vector":[0.2792038,0.033027485,0.09062182,0.054165084,0.0,0.15352578,0.036598027,0.2283746,0.13756213,0.038144425,0.0,0.060883857,0.0,0.07544422,0.047384232,0.382528,0.0,0.06128717,0.0,0.0,0.0,0.24180841,0.030775614,0.2186471,0.0,0.04043071,0.028811214,0.0849597,0.16652247,0.32826987,0.0,0.1016899,0.0,0.0,0.12658145,0.0,0.14361952,0.10966838,0.0,0.0,0.07319605,0.08389013,0.14307941,0.08461245,0.0,0.0,0.104163624,0.090574555,0.05762243,0.08362329,0.021158235,0.0,0.3428205,0.15941814,0.052081812,0.11284392,0.052081812,0.03224112,0.033853177,0.24438737,0.08634036,0.100305706,0.115716316,0.12435861]},{"chunk":{"file_path":"docs\\02_CORE_INTERFACES.md","chunk_index":359,"start_line":121,"end_line":135,"content":"    \n    // 4. Out-of-band urgent emergency command (E-STOP)\n    ValueTask SendUrgentAsync(TMessage urgentMessage);\n    \n    ValueTask StartAsync(CancellationToken ct = default);\n    ValueTask StopAsync();\n}\n```\n\n</div>\n</div>\n\n<!-- Section 4: Exceptions -->\n<div style=\"background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);\">\n<div style=\"background: #f8fafc; border-bottom: 1px solid #e2e8f0; padding: 12px 18px; display: flex; justify-content: space-between; align-items: center;\">","score":0.0},"vector":[0.11116872,0.0,0.1688871,0.0425