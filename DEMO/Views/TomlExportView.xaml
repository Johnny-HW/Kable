<UserControl x:Class="Kable.ConfigStudio.Views.TomlExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization;assembly=Kable.UI.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOML Preview Card -->
        <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="16" Padding="20" Margin="0,0,0,16" BorderBrush="#313244" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{loc:Loc Header_TomlPreview}" FontWeight="Bold" FontSize="15" Foreground="#A6E3A1" VerticalAlignment="Center"/>
                    <Button Content="{loc:Loc Btn_Refresh}" Command="{Binding UpdateTomlPreviewCommand}" 
                            DockPanel.Dock="Right" Padding="14,6" Background="#313244" Foreground="#CDD6F4" FontWeight="SemiBold" 
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>
                <TextBox Grid.Row="1" Text="{Binding GeneratedTomlPreview}" 
                         Background="#252538" Foreground="#CDD6F4" FontFamily="Consolas, Courier New" FontSize="13" 
                         BorderThickness="0" Padding="14" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Border>

        <!-- Bottom Action Bar Card -->
        <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="16" Padding="18,14" BorderBrush="#313244" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock Text="Kable Configuration Studio — Real-Time Multi-Protocol Engine" Foreground="#A6ADC8" VerticalAlignment="Center" FontWeight="Medium"/>
                <Button Content="{loc:Loc Btn_SaveConfig}" Command="{Binding SaveToFileCommand}" 
                        DockPanel.Dock="Right" Padding="24,10" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="14" 
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
