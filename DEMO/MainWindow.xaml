<Window x:Class="Kable.ConfigStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Kable.ConfigStudio.ViewModels"
        xmlns:views="clr-namespace:Kable.ConfigStudio.Views"
        xmlns:controls="clr-namespace:Kable.UI.Wpf.Controls;assembly=Kable.UI.Wpf"
        xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization;assembly=Kable.UI.Wpf"
        mc:Ignorable="d"
        Title="🔌 DEMO" Height="860" Width="1200"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <!-- Outer Window Drop Shadow & Rounded Border -->
    <Border Margin="8" Background="#F8FAFC" CornerRadius="14" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.10" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>   <!-- 1. Apple Custom Titlebar -->
                <RowDefinition Height="Auto"/> <!-- 2. Sub-Header & Navigation Bar Combined -->
                <RowDefinition Height="*"/>    <!-- 3. Active Screen Viewport Container -->
            </Grid.RowDefinitions>

            <!-- 1. Custom Apple macOS/iOS Style Title Bar -->
            <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14,14,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" 
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel LastChildFill="True" Margin="14,0">
                    <!-- Left: Traffic Light Window Buttons (Red Close, Yellow Min, Green Max) -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Red Close Button -->
                        <Button Click="CloseButton_Click" Width="13" Height="13" Margin="0,0,8,0" Cursor="Hand" ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="circle" Background="#FF5F56" CornerRadius="7" BorderBrush="#E0443E" BorderThickness="0.5">
                                        <TextBlock Text="✕" FontSize="8" Foreground="#4D0000" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" x:Name="sym"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="sym" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Yellow Minimize Button -->
                        <Button Click="MinimizeButton_Click" Width="13" Height="13" Margin="0,0,8,0" Cursor="Hand" ToolTip="Minimize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="circle" Background="#FFBD2E" CornerRadius="7" BorderBrush="#DEA123" BorderThickness="0.5">
                                        <TextBlock Text="–" FontSize="9" FontWeight="Bold" Foreground="#664400" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" x:Name="sym"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="sym" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Green Maximize Button -->
                        <Button Click="MaximizeButton_Click" Width="13" Height="13" Margin="0,0,14,0" Cursor="Hand" ToolTip="Maximize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="circle" Background="#27C93F" CornerRadius="7" BorderBrush="#1AAB29" BorderThickness="0.5">
                                        <TextBlock Text="+" FontSize="9" FontWeight="Bold" Foreground="#004D00" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" x:Name="sym"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="sym" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock Text="🔌 DEMO" FontWeight="Bold" FontSize="13" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <TextBlock Text=" — Kable Hardware Communication Studio" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="6,1,0,0"/>
                    </StackPanel>

                    <!-- Right Status Tags in Titlebar -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="8,3" Margin="0,0,8,0">
                            <TextBlock Text="v1.2.0 Clean Light" Foreground="#0071E3" FontWeight="SemiBold" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2. Streamlined Combined Navigation & Control Bar -->
            <Border Grid.Row="1" Background="#FFFFFF" Padding="14,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                    <!-- Left: Navigation Segments -->
                    <Border DockPanel.Dock="Left" Background="#F1F5F9" CornerRadius="12" Padding="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <!-- 0. 통신 설정 -->
                            <RadioButton Content="{loc:Loc Nav_Config}" Style="{StaticResource IosNavRadioBtn}" 
                                         IsChecked="{Binding IsNavConfig, Mode=OneWay}"
                                         Command="{Binding SetNavCommand}" CommandParameter="0"/>

                            <!-- 1. 패킷/명령 카탈로그 (상시/수시 설정) -->
                            <RadioButton Content="{loc:Loc Nav_Packets}" Style="{StaticResource IosNavRadioBtn}" 
                                         IsChecked="{Binding IsNavPackets, Mode=OneWay}"
                                         Command="{Binding SetNavCommand}" CommandParameter="1"/>

                            <!-- 2. 수시 명령 콘솔 -->
                            <RadioButton Content="{loc:Loc Nav_Inspector}" Style="{StaticResource IosNavRadioBtn}" 
                                         IsChecked="{Binding IsNavInspector, Mode=OneWay}"
                                         Command="{Binding SetNavCommand}" CommandParameter="2"/>

                            <!-- 3. 상시 텔레메트리 -->
                            <RadioButton Content="{loc:Loc Nav_Telemetry}" Style="{StaticResource IosNavRadioBtn}" 
                                         IsChecked="{Binding IsNavTelemetry, Mode=OneWay}"
                                         Command="{Binding SetNavCommand}" CommandParameter="3"/>

                            <!-- 4. 실시간 알람 -->
                            <RadioButton Content="{loc:Loc Nav_Alarms}" Style="{StaticResource IosNavRadioBtn}" 
                                         IsChecked="{Binding IsNavAlarms, Mode=OneWay}"
                                         Command="{Binding SetNavCommand}" CommandParameter="4"/>

                            <!-- 5. TOML 내보내기 -->
                            <RadioButton Content="{loc:Loc Nav_Export}" Style="{StaticResource IosNavRadioBtn}" 
                                         IsChecked="{Binding IsNavExport, Mode=OneWay}"
                                         Command="{Binding SetNavCommand}" CommandParameter="5"/>
                        </StackPanel>
                    </Border>

                    <!-- Right: Compact Simulator Control & Language Selector -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TestStatus}" Foreground="{Binding TestResultColor}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Simulation Streaming Toggle Button -->
                        <Button Command="{Binding ToggleSimulationCommand}" 
                                Padding="12,6" Margin="0,0,8,0" FontWeight="Bold" FontSize="11" Cursor="Hand" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="Foreground" Value="#334155"/>
                                    <Setter Property="Content" Value="🔬 가상 시뮬레이터 시작"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSimulatorRunning}" Value="True">
                                            <Setter Property="Background" Value="#34C759"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="Content" Value="🟢 스트리밍 중"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Reusable Language Selector Component -->
                        <controls:LanguageSelectorControl Margin="0,0,8,0"/>

                        <!-- Engine Badges -->
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="8,4">
                            <TextBlock Text="0-GC Hotpath" Foreground="#34C759" FontWeight="Bold" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 3. Active Screen Viewport (Decoupled Multi-View Container) -->
            <Grid Grid.Row="2" Margin="10">
                <!-- Screen 0: Connection Configuration -->
                <views:ConnectionConfigView Visibility="{Binding IsNavConfig, Converter={StaticResource BoolToVis}}"/>

                <!-- Screen 1: Packet Catalog & Traffic Classification -->
                <controls:PacketCatalogView Visibility="{Binding IsNavPackets, Converter={StaticResource BoolToVis}}"/>

                <!-- Screen 2: Live Aperiodic Command Inspector -->
                <views:LiveInspectorView Visibility="{Binding IsNavInspector, Converter={StaticResource BoolToVis}}"/>

                <!-- Screen 3: High-rate Telemetry Stream Dashboard -->
                <views:TelemetryDashboardView Visibility="{Binding IsNavTelemetry, Converter={StaticResource BoolToVis}}"/>

                <!-- Screen 4: Spontaneous Alarm Monitor -->
                <views:AlarmMonitorView Visibility="{Binding IsNavAlarms, Converter={StaticResource BoolToVis}}"/>

                <!-- Screen 5: TOML Config Preview & Save -->
                <views:TomlExportView Visibility="{Binding IsNavExport, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
