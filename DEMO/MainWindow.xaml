<Window x:Class="Kable.ConfigStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Kable.ConfigStudio.ViewModels"
        xmlns:views="clr-namespace:Kable.ConfigStudio.Views"
        xmlns:controls="clr-namespace:Kable.UI.Wpf.Controls;assembly=Kable.UI.Wpf"
        xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization;assembly=Kable.UI.Wpf"
        mc:Ignorable="d"
        Title="🔌 Kable Studio" Height="820" Width="1160"
        WindowStartupLocation="CenterScreen" Background="#0F1017">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. iOS Glass Header -->
            <RowDefinition Height="Auto"/> <!-- 2. iOS Segment Navigation Bar -->
            <RowDefinition Height="*"/>    <!-- 3. Active Viewport Container -->
        </Grid.RowDefinitions>

        <!-- 1. Header (iOS Glass Card) -->
        <Border Grid.Row="0" Background="#181926" CornerRadius="18" Padding="18,12" Margin="0,0,0,14" BorderBrush="#313244" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔌 " FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Header_CommInspector}" FontSize="18" FontWeight="Bold" Foreground="#FAB387" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Kable Real-Time High-Performance Hardware Communication Studio" FontSize="11" Foreground="#9399B2" Margin="4,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Reusable Language Selector Component -->
                    <controls:LanguageSelectorControl Margin="0,0,12,0"/>

                    <!-- Engine Status Badges -->
                    <Border Background="#252538" CornerRadius="10" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="Engine: v1.2.0" Foreground="#89B4FA" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <Border Background="#252538" CornerRadius="10" Padding="10,5">
                        <TextBlock Text="0-GC Hotpath" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>



        <!-- 2. iOS Segmented Navigation Bar -->
        <Border Grid.Row="1" Background="#181926" CornerRadius="20" Padding="6" Margin="0,0,0,16" BorderBrush="#313244" BorderThickness="1" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <!-- 0. 통신 설정 -->
                <RadioButton Content="{loc:Loc Nav_Config}" Style="{StaticResource IosNavRadioBtn}" 
                             IsChecked="{Binding IsNavConfig, Mode=OneWay}"
                             Command="{Binding SetNavCommand}" CommandParameter="0"/>

                <!-- 1. 수시 명령 콘솔 -->
                <RadioButton Content="{loc:Loc Nav_Inspector}" Style="{StaticResource IosNavRadioBtn}"
                             IsChecked="{Binding IsNavInspector, Mode=OneWay}"
                             Command="{Binding SetNavCommand}" CommandParameter="1"/>

                <!-- 2. 상시 텔레메트리 -->
                <RadioButton Content="{loc:Loc Nav_Telemetry}" Style="{StaticResource IosNavRadioBtn}"
                             IsChecked="{Binding IsNavTelemetry, Mode=OneWay}"
                             Command="{Binding SetNavCommand}" CommandParameter="2"/>

                <!-- 3. 실시간 알람 -->
                <RadioButton Content="{loc:Loc Nav_Alarms}" Style="{StaticResource IosNavRadioBtn}"
                             IsChecked="{Binding IsNavAlarms, Mode=OneWay}"
                             Command="{Binding SetNavCommand}" CommandParameter="3"/>

                <!-- 4. TOML 내보내기 -->
                <RadioButton Content="{loc:Loc Nav_Export}" Style="{StaticResource IosNavRadioBtn}"
                             IsChecked="{Binding IsNavExport, Mode=OneWay}"
                             Command="{Binding SetNavCommand}" CommandParameter="4"/>
            </StackPanel>
        </Border>

        <!-- 3. Active Screen Viewport (Decoupled Multi-View Container) -->
        <Grid Grid.Row="2">
            <!-- Screen 0: Connection Configuration -->
            <views:ConnectionConfigView Visibility="{Binding IsNavConfig, Converter={StaticResource BoolToVis}}"/>

            <!-- Screen 1: Live Aperiodic Command Inspector -->
            <views:LiveInspectorView Visibility="{Binding IsNavInspector, Converter={StaticResource BoolToVis}}"/>

            <!-- Screen 2: High-rate Telemetry Stream Dashboard -->
            <views:TelemetryDashboardView Visibility="{Binding IsNavTelemetry, Converter={StaticResource BoolToVis}}"/>

            <!-- Screen 3: Spontaneous Alarm Monitor -->
            <views:AlarmMonitorView Visibility="{Binding IsNavAlarms, Converter={StaticResource BoolToVis}}"/>

            <!-- Screen 4: TOML Config Preview & Save -->
            <views:TomlExportView Visibility="{Binding IsNavExport, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Window>
