<Window x:Class="Kable.ConfigStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Kable.ConfigStudio.ViewModels"
        xmlns:views="clr-namespace:Kable.ConfigStudio.Views"
        xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization;assembly=Kable.UI.Wpf"
        mc:Ignorable="d"
        Title="🔌 Kable Studio" Height="820" Width="1160"
        WindowStartupLocation="CenterScreen" Background="#0F1017">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="BgDark" Color="#181926"/>
        <SolidColorBrush x:Key="BgCard" Color="#212234"/>
        <SolidColorBrush x:Key="BgInput" Color="#2E3046"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3D405B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F4F6FC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9399B2"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#89B4FA"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#A6E3A1"/>
        <SolidColorBrush x:Key="AccentYellow" Color="#F9E2AF"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FAB387"/>

        <!-- iOS Style Glass Pill ComboBox ToggleButton -->
        <ControlTemplate x:Key="IosComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" 
                        Background="#24273A" CornerRadius="16" 
                        BorderBrush="#3D405B" BorderThickness="1"/>
                <Border Grid.Column="0" Background="Transparent" Margin="1" />
                <Path x:Name="Arrow" Grid.Column="1" 
                      HorizontalAlignment="Center" VerticalAlignment="Center" 
                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#89B4FA" Margin="0,1,6,0"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#363A4F"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#89B4FA"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#B4BEFE"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#363A4F"/>
                    <Setter TargetName="Border" Property="BorderBrush" Value="#89B4FA"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- iOS Style ComboBox Template -->
        <Style x:Key="IosComboBoxStyle" TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Foreground" Value="#F4F6FC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource IosComboBoxToggleButton}" 
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="14,0,28,0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide"
                                   VerticalOffset="4">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#181926" 
                                            BorderThickness="1" 
                                            BorderBrush="#3D405B" 
                                            CornerRadius="14" 
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Style ComboBoxItem Template -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" 
                                Background="Transparent" 
                                CornerRadius="10" 
                                Padding="{TemplateBinding Padding}" 
                                Margin="0,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2E3046"/>
                                <Setter Property="Foreground" Value="#89B4FA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#89B4FA"/>
                                <Setter Property="Foreground" Value="#11111B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- iOS Style Segment Navigation RadioButton -->
        <Style x:Key="IosNavRadioBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder" 
                                Background="Transparent" 
                                CornerRadius="16" 
                                Padding="16,8" 
                                Margin="2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#252538"/>
                                <Setter Property="Foreground" Value="#CDD6F4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#89B4FA"/>
                                <Setter Property="Foreground" Value="#11111B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transport Selection Radio Button (iOS Pill) -->
        <Style x:Key="TransportRadioBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder" 
                                Background="#1E1E2E" 
                                BorderBrush="#313244" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Padding="14,8" 
                                Margin="0,0,8,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#2E3046"/>
                                <Setter Property="Foreground" Value="#F4F6FC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#89B4FA"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#89B4FA"/>
                                <Setter Property="Foreground" Value="#11111B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 1. iOS Glass Header -->
            <RowDefinition Height="Auto"/> <!-- 2. iOS Segment Navigation Bar -->
            <RowDefinition Height="*"/>    <!-- 3. Active Viewport Container -->
        </Grid.RowDefinitions>

        <!-- 1. Header (iOS Glass Card) -->
        <Border Grid.Row="0" Background="#181926" CornerRadius="18" Padding="18,12" Margin="0,0,0,14" BorderBrush="#313244" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔌 " FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Header_CommInspector}" FontSize="18" FontWeight="Bold" Foreground="#FAB387" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Kable Real-Time High-Performance Hardware Communication Studio" FontSize="11" Foreground="#9399B2" Margin="4,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- iOS Pill Language Selector -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="🌐" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Style="{StaticResource IosComboBoxStyle}"
                                  ItemsSource="{Binding AvailableLanguages}" 
                                  SelectedItem="{Binding SelectedLanguage}" 
                                  Width="180"/>
                    </StackPanel>

                    <!-- Engine Status Badges -->
                    <Border Background="#252538" CornerRadius="10" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="Engine: v1.2.0" Foreground="#89B4FA" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <Border Background="#252538" CornerRadius="10" Padding="10,5">
                        <TextBlock Text="0-GC Hotpath" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. iOS Segmented Navigation Bar -->
        <Border Grid.Row="1" Background="#181926" CornerRadius="20" Padding="6" Margin="0,0,0,16" BorderBrush="#313244" BorderThickness="1" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <!-- 0. 통신 설정 -->
                <RadioButton Content="{loc:Loc Nav_Config}" Style="{StaticResource IosNavRadioBtn}" 
                             IsChecked="{Binding IsNavConfig, Mode=OneWay}"
                             Command="{Binding SetNavCommand}" CommandParameter="0"/>

                <!-- 1. 수시 명령 콘솔 -->
                <RadioButton Content="{loc:Loc Nav_Inspector}" Style="{StaticResource IosNavRadioBtn}"
                             IsChecked="{Binding IsNavInspector, Mode=OneWay}"
                             Command="{Binding SetNavCommand}" CommandParameter="1"/>

                <!-- 2. 상시 텔레메트리 -->
                <RadioButton Content="{loc:Loc Nav_Telemetry}" Style="{StaticResource IosNavRadioBtn}"
                             IsChecked="{Binding IsNavTelemetry, Mode=OneWay}"
                             Command="{Binding SetNavCommand}" CommandParameter="2"/>

                <!-- 3. 실시간 알람 -->
                <RadioButton Content="{loc:Loc Nav_Alarms}" Style="{StaticResource IosNavRadioBtn}"
                             IsChecked="{Binding IsNavAlarms, Mode=OneWay}"
                             Command="{Binding SetNavCommand}" CommandParameter="3"/>

                <!-- 4. TOML 내보내기 -->
                <RadioButton Content="{loc:Loc Nav_Export}" Style="{StaticResource IosNavRadioBtn}"
                             IsChecked="{Binding IsNavExport, Mode=OneWay}"
                             Command="{Binding SetNavCommand}" CommandParameter="4"/>
            </StackPanel>
        </Border>

        <!-- 3. Active Screen Viewport (Decoupled Multi-View Container) -->
        <Grid Grid.Row="2">
            <!-- Screen 0: Connection Configuration -->
            <views:ConnectionConfigView Visibility="{Binding IsNavConfig, Converter={StaticResource BoolToVis}}"/>

            <!-- Screen 1: Live Aperiodic Command Inspector -->
            <views:LiveInspectorView Visibility="{Binding IsNavInspector, Converter={StaticResource BoolToVis}}"/>

            <!-- Screen 2: High-rate Telemetry Stream Dashboard -->
            <views:TelemetryDashboardView Visibility="{Binding IsNavTelemetry, Converter={StaticResource BoolToVis}}"/>

            <!-- Screen 3: Spontaneous Alarm Monitor -->
            <views:AlarmMonitorView Visibility="{Binding IsNavAlarms, Converter={StaticResource BoolToVis}}"/>

            <!-- Screen 4: TOML Config Preview & Save -->
            <views:TomlExportView Visibility="{Binding IsNavExport, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</Window>
