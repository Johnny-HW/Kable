<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 전천후 멀티 타겟팅: 구형 설비(netstandard2.0)부터 최신 고성능(.NET 8, 10)까지 완전 지원 -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <PackageId>Kable</PackageId>
    <Description>Asynchronous hardware communication engine with reusable pipeline buffers, configurable request routing, and optional connection recovery.</Description>
    <PackageTags>industrial;hardware;serial;socket;namedpipe;pipelines;rsocket;reactive;zerogc</PackageTags>
  </PropertyGroup>

  <!-- 프로젝트 참조 (Kable.Core 계약 계층) -->
  <ItemGroup>
    <ProjectReference Include="..\Kable.Core\Kable.Core.csproj" />
  </ItemGroup>

  <!-- 공통 종속성 -->
  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Kable.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- netstandard2.0 구형 플랫폼용 폴리필 패키지 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

</Project>
