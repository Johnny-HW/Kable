<UserControl x:Class="Kable.UI.Wpf.AlarmListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Kable.UI.Wpf.ViewModels"
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="850">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="*" />     <!-- Alarm List Grid -->
        </Grid.RowDefinitions>

        <!-- 1. Toolbar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="8,6" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{loc:Loc Header_Alarms}" Foreground="#F38BA8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="{loc:Loc Btn_Clear}" Command="{Binding ClearAlarmsCommand}" 
                            Padding="10,4" Margin="0,0,12,0" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{loc:Loc Lbl_Filter}" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="160" 
                             Background="#252526" Foreground="White" BorderBrush="#3F3F46" Padding="4,2"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Alarm List Grid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Alarms}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D2D30"
                  Background="#1E1E1E" RowBackground="#1E1E1E" AlternatingRowBackground="#252526"
                  Foreground="#DCDCDC" BorderThickness="0" SelectionMode="Single"
                  FontFamily="Segoe UI" FontSize="12">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2D2D30"/>
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Col_AlarmCode}" Binding="{Binding AlarmCode}" Width="140" FontWeight="Bold"/>
                <DataGridTextColumn Header="{loc:Loc Col_Severity}" Binding="{Binding Severity}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding SeverityColor}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{loc:Loc Col_Time}" Binding="{Binding Timestamp}" Width="100"/>
                <DataGridTextColumn Header="{loc:Loc Col_Device}" Binding="{Binding DeviceId}" Width="100"/>
                <DataGridTextColumn Header="{loc:Loc Col_State}" Binding="{Binding State}" Width="80"/>
                <DataGridTextColumn Header="{loc:Loc Col_AlarmMessage}" Binding="{Binding Message}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
