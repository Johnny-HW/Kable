<UserControl x:Class="Kable.UI.Wpf.Controls.LiveDiagnosticsBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kable.UI.Wpf;component/Themes/IosTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#1E1E2E" CornerRadius="16" Padding="16" BorderBrush="#313244" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <DockPanel>
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Header_LiveTest}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource KableAccentYellow}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding TestStatus}" Foreground="{Binding TestResultColor}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{loc:Loc Btn_RunLiveTest}" Command="{Binding RunLiveTestCommand}" 
                        Padding="16,8" Margin="0,0,10,0" Background="#F9E2AF" Foreground="#11111B" FontWeight="Bold" 
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="{loc:Loc Btn_RunSimulation}" Command="{Binding RunMockSimulationCommand}" 
                        Style="{StaticResource IosSecondaryButtonStyle}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
