<UserControl x:Class="Kable.UI.Wpf.Controls.PacketCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:Kable.UI.Wpf.Models"
             xmlns:obs="clr-namespace:Kable.Observability;assembly=Kable.Core"
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kable.UI.Wpf;component/Themes/IosTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Action Header Bar -->
            <RowDefinition Height="*"/>    <!-- DataGrid of Packets -->
        </Grid.RowDefinitions>

        <!-- 1. Top Action & Simulation Status Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="16" Padding="16" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Header_PacketCatalog}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource KableAccentBlue}" Margin="0,0,0,4"/>
                    <TextBlock Text="{loc:Loc Lbl_PacketCatalogDesc}" 
                               Foreground="{StaticResource KableTextSecondary}" FontSize="11"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Simulation Toggle Pill Button -->
                    <Button Command="{Binding ToggleSimulationCommand}" 
                            Padding="16,8" Margin="0,0,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#34C759"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Content" Value="{loc:Loc Btn_SimStart}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSimulatorRunning}" Value="True">
                                        <Setter Property="Background" Value="#FF3B30"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Content" Value="{loc:Loc Btn_SimStop}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="{loc:Loc Btn_AddPacket}" Command="{Binding AddPacketItemCommand}" 
                            Style="{StaticResource IosSecondaryButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Packet Catalog Grid -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <DataGrid ItemsSource="{Binding PacketCatalog}" 
                      IsReadOnly="False"
                      Style="{StaticResource IosDataGridStyle}">
                <DataGrid.Columns>
                    <!-- Enable Checkbox -->
                    <DataGridCheckBoxColumn Header="{loc:Loc Col_Active}" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="55"/>

                    <!-- Packet ID (Read Only Key) -->
                    <DataGridTextColumn Header="{loc:Loc Col_PacketId}" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="140" FontWeight="Bold" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Name -->
                    <DataGridTextColumn Header="{loc:Loc Col_PacketName}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Traffic Kind (Aperiodic vs Periodic vs Alarm) -->
                    <DataGridTemplateColumn Header="{loc:Loc Col_TrafficKind}" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}" 
                                          Style="{StaticResource IosComboBoxStyle}" Height="30" FontSize="11" Margin="0,2">
                                    <obs:TrafficKind>AperiodicCommand</obs:TrafficKind>
                                    <obs:TrafficKind>PeriodicTelemetry</obs:TrafficKind>
                                    <obs:TrafficKind>SpontaneousAlarm</obs:TrafficKind>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Interval (ms) - For Periodic -->
                    <DataGridTextColumn Header="{loc:Loc Col_Interval}" Binding="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" Width="95">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#0071E3"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Unit -->
                    <DataGridTextColumn Header="{loc:Loc Col_Unit}" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Base Value -->
                    <DataGridTextColumn Header="{loc:Loc Col_SimulatedBase}" Binding="{Binding SimulatedBaseValue, UpdateSourceTrigger=PropertyChanged}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Command Payload / Template -->
                    <DataGridTextColumn Header="{loc:Loc Col_PayloadFormat}" Binding="{Binding CommandPayload, UpdateSourceTrigger=PropertyChanged}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
