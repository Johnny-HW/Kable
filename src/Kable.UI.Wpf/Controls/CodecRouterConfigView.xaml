<UserControl x:Class="Kable.UI.Wpf.Controls.CodecRouterConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kable.UI.Wpf;component/Themes/IosTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource IosCardBorderStyle}">
        <StackPanel>
            <TextBlock Text="{loc:Loc Header_CodecRouter}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource KableAccentBlue}" Margin="0,0,0,14"/>
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Framing Codec:" Foreground="{StaticResource KableTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource IosComboBoxStyle}" ItemsSource="{Binding AvailableCodecs}" SelectedItem="{Binding Profile.Codec}"/>
                </StackPanel>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Transaction Router:" Foreground="{StaticResource KableTextSecondary}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource IosComboBoxStyle}" ItemsSource="{Binding AvailableRouters}" SelectedItem="{Binding Profile.Router}"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
