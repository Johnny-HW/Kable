<UserControl x:Class="Kable.UI.Wpf.Controls.TomlConfigEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kable.UI.Wpf;component/Themes/IosTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOML Preview Card -->
        <Border Grid.Row="0" Style="{StaticResource IosCardBorderStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{loc:Loc Header_TomlPreview}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource KableAccentGreen}" VerticalAlignment="Center"/>
                    <Button Content="{loc:Loc Btn_Refresh}" Command="{Binding UpdateTomlPreviewCommand}" 
                            DockPanel.Dock="Right" Style="{StaticResource IosSecondaryButtonStyle}"/>
                </DockPanel>
                <TextBox Grid.Row="1" Text="{Binding GeneratedTomlPreview}" 
                         Background="#F8FAFC" Foreground="#0F172A" FontFamily="Consolas, Courier New" FontSize="13" 
                         BorderThickness="0" Padding="14" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Border>

        <!-- Bottom Action Bar Card -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="16" Padding="18,14" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock Text="{loc:Loc Lbl_TomlFooter}" Foreground="{StaticResource KableTextSecondary}" VerticalAlignment="Center" FontWeight="Medium"/>
                <Button Content="{loc:Loc Btn_SaveConfig}" Command="{Binding SaveToFileCommand}" 
                        DockPanel.Dock="Right" Style="{StaticResource IosPrimaryButtonStyle}" FontSize="14" Padding="24,10"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
