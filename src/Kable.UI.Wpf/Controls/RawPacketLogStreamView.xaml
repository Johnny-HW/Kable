<UserControl x:Class="Kable.UI.Wpf.Controls.RawPacketLogStreamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization"
             xmlns:controls="clr-namespace:Kable.UI.Wpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="800">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Action Header Bar -->
            <RowDefinition Height="*"/>    <!-- DataGrid of Raw Packets -->
            <RowDefinition Height="Auto"/> <!-- Bottom Hex Dump Preview -->
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar -->
        <Border Grid.Row="0" Background="#F8FAFC" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Header_RawPacketStream}" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <!-- Health & Metrics Badge Strip -->
                    <Border Background="{Binding StateBadgeColor}" CornerRadius="10" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionState}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RttText, StringFormat='⏱ {0}'}" Foreground="#334155" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PacketCounterText}" Foreground="#334155" FontSize="11"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="6,3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ErrorRateText}" Foreground="#E11D48" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <!-- Pause / Resume -->
                    <Button Content="{loc:Loc Btn_Pause}" Command="{Binding TogglePauseCommand}" 
                            Padding="10,4" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <!-- Clear -->
                    <Button Content="{loc:Loc Btn_Clear}" Command="{Binding ClearLogsCommand}" 
                            Padding="10,4" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#64748B" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <!-- Save to File (History Export) -->
                    <Button Content="{loc:Loc Btn_ExportLog}" Command="{Binding ExportToFileCommand}" 
                            Padding="10,4" Margin="0,0,6,0" Background="#EFF6FF" Foreground="#0071E3" FontWeight="Bold" FontSize="11" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Lbl_Filter}" Foreground="#64748B" FontSize="11" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="150" 
                             Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6,3" FontSize="11">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Packet List Grid (Shared Control) -->
        <controls:PacketLogGrid Grid.Row="1"/>

        <!-- 3. Bottom Quick Hex Dump Bar -->
        <Border Grid.Row="2" Background="#F8FAFC" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <TextBox Text="{Binding SelectedPacket.HexDump, Mode=OneWay, FallbackValue='Click a packet row above to view full byte inspection.'}" 
                     FontFamily="Consolas, Courier New" FontSize="11" Foreground="#475569"
                     Background="Transparent" BorderThickness="0" MaxHeight="60"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>
    </Grid>
</UserControl>
