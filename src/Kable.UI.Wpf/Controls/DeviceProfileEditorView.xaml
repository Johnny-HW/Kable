<UserControl x:Class="Kable.UI.Wpf.Controls.DeviceProfileEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kable.UI.Wpf;component/Themes/IosTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource IosCardBorderStyle}">
        <StackPanel>
            <TextBlock Text="{loc:Loc Header_DeviceInfo}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource KableAccentBlue}" Margin="0,0,0,14"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Lbl_DeviceId}" Foreground="{StaticResource KableTextSecondary}" VerticalAlignment="Center" FontWeight="Medium"/>
                <TextBox Grid.Column="1" Text="{Binding Profile.DeviceName, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource IosTextBoxStyle}"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc Lbl_Description}" Foreground="{StaticResource KableTextSecondary}" VerticalAlignment="Center" FontWeight="Medium"/>
                <TextBox Grid.Column="1" Text="{Binding Profile.Description, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource IosTextBoxStyle}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
