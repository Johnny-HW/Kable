<UserControl x:Class="Kable.UI.Wpf.Controls.StructCodeGenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Kable.UI.Wpf;component/Themes/IosTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Context Sub-Header Bar (Breadcrumbs & Target Engine) -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="14" Padding="14,10" Margin="0,0,0,10" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.04" Color="#000000"/>
            </Border.Effect>
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc CodeGen_BreadcrumbPrefix}" FontSize="11" Foreground="#64748B"/>
                    <Border Background="#F1F5F9" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc CodeGen_TitleBadge}" FontSize="11" FontWeight="Bold" Foreground="#0F172A"/>
                    </Border>
                    <Border Background="#EFF6FF" CornerRadius="6" Padding="6,2" Margin="0,0,6,0">
                        <TextBlock Text="{loc:Loc CodeGen_PackBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#0071E3"/>
                    </Border>
                    <Border Background="#F0FDF4" CornerRadius="6" Padding="6,2">
                        <TextBlock Text="{loc:Loc CodeGen_ZeroAllocBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#34C759"/>
                    </Border>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc CodeGen_LangBadge}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                    </Border>
                    <Button Content="{loc:Loc Btn_Refresh}" Command="{Binding UpdateStructCodePreviewCommand}" 
                            Style="{StaticResource IosSecondaryButtonStyle}" Padding="12,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Dual Pane: Left Struct Layout & Memory Map | Right Generated C# Code -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Struct Memory Field Map (Zero-GC Layout Inspection) -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc CodeGen_MemoryMapHeader}" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                            <Border Background="#EFF6FF" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="{loc:Loc CodeGen_TotalBytes}" FontSize="10" FontWeight="SemiBold" Foreground="#0071E3"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <!-- Memory Layout Card Deck -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{loc:Loc CodeGen_Field0_Offset}" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{loc:Loc CodeGen_Field0_Name}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" FontFamily="Consolas, -apple-system"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc CodeGen_Field0_Tag}" FontSize="10" FontWeight="Bold" Foreground="#0071E3" FontFamily="Consolas"/>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{loc:Loc CodeGen_Field1_Offset}" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{loc:Loc CodeGen_Field1_Name}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" FontFamily="Consolas, -apple-system"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc CodeGen_Field1_Tag}" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" FontFamily="Consolas"/>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{loc:Loc CodeGen_Field2_Offset}" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{loc:Loc CodeGen_Field2_Name}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" FontFamily="Consolas, -apple-system"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc CodeGen_Field_Ieee754}" FontSize="10" FontWeight="SemiBold" Foreground="#0071E3" FontFamily="Consolas"/>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{loc:Loc CodeGen_Field3_Offset}" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{loc:Loc CodeGen_Field3_Name}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" FontFamily="Consolas, -apple-system"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc CodeGen_Field_Ieee754}" FontSize="10" FontWeight="SemiBold" Foreground="#0071E3" FontFamily="Consolas"/>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{loc:Loc CodeGen_Field4_Offset}" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{loc:Loc CodeGen_Field4_Name}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" FontFamily="Consolas, -apple-system"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#EFF6FF" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc CodeGen_Field_Ieee754}" FontSize="10" FontWeight="SemiBold" Foreground="#0071E3" FontFamily="Consolas"/>
                                    </Border>
                                </DockPanel>
                            </Border>

                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="{loc:Loc CodeGen_Field5_Offset}" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{loc:Loc CodeGen_Field5_Name}" FontSize="12" FontWeight="Bold" Foreground="#0F172A" FontFamily="Consolas, -apple-system"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Right" Background="#F0FDF4" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Loc CodeGen_Field5_Tag}" FontSize="10" FontWeight="Bold" Foreground="#166534" FontFamily="Consolas"/>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                        <TextBlock Text="{loc:Loc CodeGen_ZeroAllocFootnote}" FontSize="10" Foreground="#334155" FontWeight="Medium"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Pane: C# Zero-GC Generated Driver Code Card -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.05" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc CodeGen_DriverHeader}" FontSize="11" FontWeight="Bold" Foreground="#0071E3"/>
                            <Border Background="#EFF6FF" CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="{loc:Loc CodeGen_SpanInliningBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#0071E3"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <TextBox Grid.Row="1" Text="{Binding GeneratedCSharpPreview}" 
                             Background="#F8FAFC" Foreground="#0F172A" FontFamily="Consolas, Courier New" FontSize="12" 
                             BorderThickness="0" Padding="14" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Action Bar Card -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="16" Padding="18,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <DockPanel>
                <TextBlock Text="{loc:Loc CodeGen_FooterDesc}" 
                           Foreground="{StaticResource KableTextSecondary}" VerticalAlignment="Center" FontWeight="Medium" FontSize="12"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:Loc Btn_SaveDriverCs}" Command="{Binding SaveToFileCommand}" 
                            Style="{StaticResource IosPrimaryButtonStyle}" FontSize="13" Padding="20,8"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
