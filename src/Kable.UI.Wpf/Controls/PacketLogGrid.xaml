<UserControl x:Class="Kable.UI.Wpf.Controls.PacketLogGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization">
    <DataGrid ItemsSource="{Binding Packets}"
              SelectedItem="{Binding SelectedPacket}"
              IsReadOnly="True"
              Style="{StaticResource IosDataGridStyle}">
        <DataGrid.Columns>
            <DataGridTextColumn Header="{loc:Loc Col_Seq}" Binding="{Binding SequenceNo}" Width="55"
                                ElementStyle="{StaticResource KableCellMonoCenteredStyle}"/>
            <DataGridTextColumn Header="{loc:Loc Col_Time}" Binding="{Binding Timestamp}" Width="95"
                                ElementStyle="{StaticResource KableCellMonoMutedStyle}"/>
            <DataGridTextColumn Header="{loc:Loc Col_Dir}" Binding="{Binding Direction}" Width="70"
                                ElementStyle="{StaticResource KableCellDirectionStyle}"/>
            <DataGridTextColumn Header="{loc:Loc Col_Device}" Binding="{Binding DeviceId}" Width="90"
                                ElementStyle="{StaticResource KableCellMediumTextStyle}"/>
            <DataGridTextColumn Header="{loc:Loc Col_Type}" Binding="{Binding Kind}" Width="120"
                                ElementStyle="{StaticResource KableCellTextBaseStyle}"/>
            <DataGridTextColumn Header="{loc:Loc Col_Bytes}" Binding="{Binding Length}" Width="60"
                                ElementStyle="{StaticResource KableCellMonoBytesStyle}"/>
            <DataGridTextColumn Header="{loc:Loc Col_Latency}" Binding="{Binding LatencyMs}" Width="75"
                                ElementStyle="{StaticResource KableCellMonoLatencyStyle}"/>
            <DataGridTextColumn Header="{loc:Loc Col_PayloadPreview}" Binding="{Binding AsciiPreview}" Width="*"
                                ElementStyle="{StaticResource KableCellMonoBaseStyle}"/>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
