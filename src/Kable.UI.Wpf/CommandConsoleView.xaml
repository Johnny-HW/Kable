<UserControl x:Class="Kable.UI.Wpf.CommandConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Kable.UI.Wpf.ViewModels"
             xmlns:loc="clr-namespace:Kable.UI.Wpf.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="900">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 1. Toolbar -->
            <RowDefinition Height="Auto" /> <!-- 2. Parameter Setting & Mutation Control Panel -->
            <RowDefinition Height="3*" />   <!-- 3. Packet List Grid -->
            <RowDefinition Height="Auto" /> <!-- Splitter -->
            <RowDefinition Height="2*" />   <!-- 4. Hex Dump / Inspector -->
            <RowDefinition Height="Auto" /> <!-- 5. Manual Command Injection Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Toolbar -->
        <Border Grid.Row="0" Background="#F8FAFC" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="{loc:Loc Header_CommandConsole}" Foreground="#0071E3" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Background="#E0F2FE" CornerRadius="6" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="상시 패킷 제외됨 (수시/설정 통신 전용)" Foreground="#0369A1" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="{loc:Loc Btn_Pause}" 
                            Command="{Binding TogglePauseCommand}" 
                            Padding="12,6" Margin="0,0,6,0" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="{loc:Loc Btn_Clear}" Command="{Binding ClearLogsCommand}" 
                            Padding="12,6" Margin="0,0,12,0" Background="#F1F5F9" Foreground="#64748B" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="{loc:Loc Lbl_Filter}" Foreground="#64748B" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Width="160" 
                             Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="8,4">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Parameter Setting & Mutation Control Panel (Apple Clean White Box) -->
        <Border Grid.Row="1" Background="#FFFFFF" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="⚙️ 장비 파라미터 제어 및 Setting 변경" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                    <TextBlock Text="설정값을 변경하고 전송하면 장비에 명령이 주입되고 관련 텔레메트리 기준값이 실시간으로 갱신됩니다." 
                               Foreground="#64748B" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Setting Cards ItemsControl -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding SettingParameters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="#1E293B" Margin="0,0,0,6"/>
                                    
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Slider -->
                                        <Slider Grid.Column="0" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" 
                                                Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <!-- Value Box -->
                                        <TextBox Grid.Column="1" Text="{Binding Value, StringFormat='{}{0:F1}', UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" Padding="4,2" 
                                                 FontWeight="Bold" Foreground="#0071E3" TextAlignment="Right" VerticalAlignment="Center"/>

                                        <!-- Unit Label -->
                                        <TextBlock Grid.Column="2" Text="{Binding Unit}" Foreground="#64748B" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Bottom Action & Status -->
                                    <DockPanel LastChildFill="True">
                                        <Button Content="설정 전송 (Apply)" 
                                                Command="{Binding DataContext.ApplySettingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                DockPanel.Dock="Right" Padding="10,4" Background="#0071E3" Foreground="White" 
                                                FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <TextBlock Text="{Binding LastAckMessage}" Foreground="#94A3B8" FontSize="10" 
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 3. Packet List Grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Packets}" SelectedItem="{Binding SelectedPacket}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F1F5F9"
                  Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                  Foreground="#0F172A" BorderThickness="0" SelectionMode="Single"
                  FontFamily="Segoe UI" FontSize="12">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Height" Value="34"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F1F5F9"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E0F2FE"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Col_Seq}" Binding="{Binding SequenceNo}" Width="55"/>
                <DataGridTextColumn Header="{loc:Loc Col_Time}" Binding="{Binding Timestamp}" Width="90"/>
                <DataGridTextColumn Header="{loc:Loc Col_Dir}" Binding="{Binding Direction}" Width="65">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Style.Triggers>
                                <Trigger Property="Text" Value="TX ➡">
                                    <Setter Property="Foreground" Value="#0071E3"/>
                                </Trigger>
                                <Trigger Property="Text" Value="RX ⬅">
                                    <Setter Property="Foreground" Value="#34C759"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{loc:Loc Col_Device}" Binding="{Binding DeviceId}" Width="90"/>
                <DataGridTextColumn Header="{loc:Loc Col_Type}" Binding="{Binding Kind}" Width="110"/>
                <DataGridTextColumn Header="{loc:Loc Col_Bytes}" Binding="{Binding Length}" Width="60"/>
                <DataGridTextColumn Header="{loc:Loc Col_Latency}" Binding="{Binding LatencyMs}" Width="75"/>
                <DataGridTextColumn Header="{loc:Loc Col_PayloadPreview}" Binding="{Binding AsciiPreview}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Grid Splitter -->
        <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#E2E8F0" ResizeDirection="Rows"/>

        <!-- 4. Hex Dump / Inspector -->
        <Border Grid.Row="4" Background="#F8FAFC" Padding="12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <TextBox Text="{Binding SelectedPacket.HexDump, Mode=OneWay, FallbackValue=''}" 
                     FontFamily="Consolas, Courier New" FontSize="12" Foreground="#0F172A"
                     Background="Transparent" BorderThickness="0"
                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- 5. Manual Command Injection Bar -->
        <Border Grid.Row="5" Background="#FFFFFF" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button Content="{loc:Loc Btn_SendManual}" Command="{Binding SendManualCommandCommand}" 
                        DockPanel.Dock="Right" Padding="16,8" Margin="10,0,0,0"
                        Background="#0071E3" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <TextBox Text="{Binding ManualCommandText, UpdateSourceTrigger=PropertyChanged}" 
                         Background="#F1F5F9" Foreground="#0F172A" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,6"
                         FontFamily="Consolas, Courier New" FontSize="12">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
