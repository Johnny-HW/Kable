<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Kable.UI.Wpf;component/Themes/IosTheme.Colors.xaml"/>
        <ResourceDictionary Source="/Kable.UI.Wpf;component/Themes/IosTheme.Buttons.xaml"/>
        <ResourceDictionary Source="/Kable.UI.Wpf;component/Themes/IosTheme.DataGrid.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- iOS Style Card Border (Clean White Elevation) -->
    <Style x:Key="IosCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KableBgCard}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KableBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.06" Color="{StaticResource KableShadowColor}"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- iOS Style Input TextBox (Light White) -->
    <Style x:Key="IosTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource KableBgInput}"/>
        <Setter Property="Foreground" Value="{StaticResource KableTextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource KableAccentBlue}"/>
        <Setter Property="BorderBrush" Value="{StaticResource KableBorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource KableBgCard}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource KableAccentBlue}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- iOS Style Pill ComboBox ToggleButton (Light White) -->
    <ControlTemplate x:Key="IosComboBoxToggleButton" TargetType="ToggleButton">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="28" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Border" Grid.ColumnSpan="2"
                    Background="{StaticResource KableBgCard}" CornerRadius="16"
                    BorderBrush="{StaticResource KableBorderColor}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.05" Color="{StaticResource KableShadowColor}"/>
                </Border.Effect>
            </Border>
            <Border Grid.Column="0" Background="Transparent" Margin="1" />
            <Path x:Name="Arrow" Grid.Column="1"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource KableTextSecondary}" Margin="0,1,6,0"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{StaticResource KableBgDark}"/>
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource KableBorderHighlight}"/>
                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource KableAccentBlue}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{StaticResource KableBgDark}"/>
                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource KableAccentBlue}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- iOS Style ComboBox Template (Light White) -->
    <Style x:Key="IosComboBoxStyle" TargetType="ComboBox">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource KableTextPrimary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource IosComboBoxToggleButton}"
                                      Focusable="False"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="14,0,28,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide"
                               VerticalOffset="4">
                            <Grid x:Name="DropDown"
                                  SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource KableBgCard}"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource KableBorderColor}"
                                        CornerRadius="14"
                                        Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.12" Color="{StaticResource KableShadowColor}"/>
                                    </Border.Effect>
                                    <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- iOS Style ComboBoxItem Template (Light White) -->
    <Style x:Key="IosComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource KableTextBody}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="Transparent"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource KableBgInput}"/>
                            <Setter Property="Foreground" Value="{StaticResource KableAccentBlue}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource KableAccentSkySoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource KableAccentBlue}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource IosComboBoxItemStyle}"/>

</ResourceDictionary>
