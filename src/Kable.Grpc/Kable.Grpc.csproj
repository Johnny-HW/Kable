<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <PackageId>Kable.Grpc</PackageId>
    <Description>High-performance gRPC bidirectional streaming transport adapter for Kable over System.IO.Pipelines.</Description>
    <PackageTags>industrial;hardware;grpc;http2;streaming;transport;pipelines;rsocket;reactive;zerogc</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kable.Core\Kable.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\kable_transport.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="System.IO.Pipelines" />
  </ItemGroup>

  <!-- netstandard2.0 polyfills -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
  </ItemGroup>

</Project>
