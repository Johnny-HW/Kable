<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Kable.OpcUa</PackageId>
    <Description>OPC UA client bridge with secure endpoint selection, user authentication, batch access and monitored subscriptions.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OPCFoundation.NetStandard.Opc.Ua" />
    <!-- OPCFoundation.NetStandard.Opc.Ua.Core 1.5.378.176 requires Microsoft.Extensions.Logging 10.0.8 on net8.0 too. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options" VersionOverride="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kable\Kable.csproj" />
  </ItemGroup>

</Project>
